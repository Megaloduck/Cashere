<!-- Cashere/Styles/BauhausTheme.axaml -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Bauhaus theme: primary triad (red/yellow/blue) + ink/paper neutrals,
    flat color blocking, thick ink borders instead of shadows. Corners are
    now softly rounded (see radius scale below) instead of perfectly
    square - it still reads as Bauhaus through the color blocking + thick
    borders, just friendlier on a touch/mouse UI.
    Loaded in App.axaml after FluentTheme so these setters win.
  -->
  <Styles.Resources>
    <Color x:Key="BauhausInk">#141414</Color>
    <Color x:Key="BauhausPaper">#F5F1E6</Color>
    <Color x:Key="BauhausRed">#D7263D</Color>
    <Color x:Key="BauhausBlue">#1D4E89</Color>
    <Color x:Key="BauhausYellow">#F2B705</Color>
    <Color x:Key="BauhausGray">#8A8A8A</Color>
    <Color x:Key="BauhausGrayLight">#E2DED2</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource BauhausInk}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{DynamicResource BauhausPaper}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{DynamicResource BauhausRed}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{DynamicResource BauhausBlue}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{DynamicResource BauhausYellow}"/>
    <SolidColorBrush x:Key="GrayBrush" Color="{DynamicResource BauhausGray}"/>
    <SolidColorBrush x:Key="GrayLightBrush" Color="{DynamicResource BauhausGrayLight}"/>

      <!-- Hides Fluent's default selected-tab underline/pipe, which our
     TabItem:selected yellow background already communicates on its own. -->
<SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill">Transparent</SolidColorBrush>

    <!-- Corner radius scale - reference these instead of hardcoding
         numbers, so the whole app can be re-tuned from one place. -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Spacing scale (4pt grid). Use these numbers directly for
         Margin/Padding in view XAML instead of ad-hoc values like 10, 14,
         18, 20 - keeps every screen breathing at the same rhythm. -->
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
    <Thickness x:Key="SpaceXL">24</Thickness>
  </Styles.Resources>

  <!-- Surfaces -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>
  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="LetterSpacing" Value="1"/>
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LetterSpacing" Value="2"/>
    <Setter Property="Foreground" Value="{DynamicResource GrayBrush}"/>
  </Style>

  <!-- Text Box -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InkBrush}"/>
  </Style>

  <!-- Hover - previously undefined, so it fell through to Fluent's
       default light-gray hover. This is the "white on hover" you saw. -->
  <Style Selector="TextBox:pointerover">
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
  <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
</Style>

<Style Selector="TextBox:focus">
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
  <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
  <Setter Property="BorderThickness" Value="3"/>
</Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5"/>
    <Setter Property="Background" Value="{DynamicResource GrayLightBrush}"/>
  </Style>

  <Style Selector="TextBox /template/ TextBlock#Watermark">
    <Setter Property="Foreground" Value="{DynamicResource GrayBrush}"/>
    <Setter Property="FontStyle" Value="Italic"/>
  </Style>

  <!-- Icons dropped into TextBox.InnerLeftContent (Avalonia 11) - used by
       the search boxes below, gives the icon a bit of breathing room. -->
  <Style Selector="TextBox /template/ ContentPresenter#PART_InnerLeftContentPresenter">
    <Setter Property="Margin" Value="10,0,0,0"/>
  </Style>

  <Style Selector="TextBox.accent-red">
    <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
  </Style>
  <Style Selector="TextBox.accent-red:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
  </Style>

  <Style Selector="TextBox.accent-blue">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
  </Style>
  <Style Selector="TextBox.accent-blue:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
  </Style>

  <Style Selector="TextBox.accent-yellow">
    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
  </Style>
  <Style Selector="TextBox.accent-yellow:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
  </Style>

  <Style Selector="TextBox.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,4"/>
  </Style>
  <Style Selector="TextBox.ghost:pointerover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.ghost:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,3"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="TextBox.large">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="MinHeight" Value="80"/>
  </Style>

  <Style Selector="TextBox.compact">
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="BorderThickness" Value="1.5"/>
  </Style>

  <!-- ComboBox -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
  <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
</Style>
<Style Selector="ComboBox:pressed /template/ Border#Background">
  <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
</Style>
<Style Selector="ComboBox:focus-within /template/ Border#Background">
  <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
  <Setter Property="BorderThickness" Value="3"/>
</Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
  </Style>

  <!-- DatePicker - previously had zero styling at all, hence full white. -->
  <Style Selector="DatePicker">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>      
    <Setter Property="Height" Value="35"/>      
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
    <Style Selector="DatePicker:pointerover">
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style Selector="DatePicker:pointerover /template/ Border#PART_BorderElement">
  <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
</Style>
  <Style Selector="DatePicker:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
  </Style>

  <!-- The small calendar-icon button inside the DatePicker shell. -->
  <Style Selector="DatePicker /template/ Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="DatePicker /template/ Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
  </Style>

  <!-- The calendar popup the DatePicker opens -->
  <Style Selector="Calendar">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
  </Style>
  <Style Selector="CalendarButton">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="CalendarButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
  </Style>
  <Style Selector="CalendarDayButton">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
  </Style>
  <Style Selector="CalendarDayButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
  </Style>
  <Style Selector="CalendarDayButton:selected">
    <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
  </Style>

  <!-- ToggleButton - covers the dropdown arrow inside ComboBox and the
       calendar-open toggle inside DatePicker. Both were showing Fluent's
       default whitish hover before this. -->
  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
  </Style>
  <Style Selector="ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="ToggleButton:checked">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
  </Style>

  <!-- Tabs -->
  <Style Selector="TabItem">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2,2,2,0"/>
    <Setter Property="CornerRadius" Value="8,8,0,0"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource GrayLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource YellowBrush}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
  </Style>

  <!-- Buttons: flat, thick ink border, invert on hover -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource YellowBrush}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <Style Selector="Button.accent-blue">
    <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button.accent-blue:pointerover">
<Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
  </Style>

  <Style Selector="Button.accent-red">
    <Setter Property="Background" Value="{DynamicResource RedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button.accent-red:pointerover">
      <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
  </Style>

  <Style Selector="Button.accent-yellow">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button.accent-yellow:pointerover">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/>
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource GrayBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
      <Style Selector="Button.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/>
  </Style>

  <Style Selector="Button.product-tile">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.product-tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
  </Style>

  <!-- ScrollBar - Fluent's default thumb hover is a translucent white
       overlay, which reads as a stray white smear against the paper
       background. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource GrayBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
  </Style>

  <!-- Cards & rules -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
  </Style>

  <!-- Left as a true square rule on purpose - it's a structural divider,
       not a container, so it stays flat even though everything else now
       has soft corners. -->
  <Style Selector="Border.rule-thick">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Height" Value="3"/>
  </Style>

</Styles>