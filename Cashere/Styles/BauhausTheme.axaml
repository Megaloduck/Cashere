<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Bauhaus theme: primary triad (red/yellow/blue) + ink/paper neutrals,
    flat color blocking, square corners, thick borders instead of shadows.
    Loaded in App.axaml after FluentTheme so these setters win.
  -->
  <Styles.Resources>
    <Color x:Key="BauhausInk">#141414</Color>
    <Color x:Key="BauhausPaper">#F5F1E6</Color>
    <Color x:Key="BauhausRed">#D7263D</Color>
    <Color x:Key="BauhausBlue">#1D4E89</Color>
    <Color x:Key="BauhausYellow">#F2B705</Color>
    <Color x:Key="BauhausGray">#8A8A8A</Color>
    <Color x:Key="BauhausGrayLight">#E2DED2</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource BauhausInk}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource BauhausPaper}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource BauhausRed}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BauhausBlue}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource BauhausYellow}"/>
    <SolidColorBrush x:Key="GrayBrush" Color="{StaticResource BauhausGray}"/>
    <SolidColorBrush x:Key="GrayLightBrush" Color="{StaticResource BauhausGrayLight}"/>
  </Styles.Resources>

  <!-- Surfaces -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>
  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="LetterSpacing" Value="1"/>
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LetterSpacing" Value="2"/>
    <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
  </Style>

        <!-- Text Box -->
<Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
</Style>

<!-- Focus state - yellow accent -->
<Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
</Style>

<!-- Disabled state -->
<Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5"/>
    <Setter Property="Background" Value="{StaticResource GrayLightBrush}"/>
</Style>

<!-- Selection color -->
<Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="{StaticResource YellowBrush}"/>
    <Setter Property="SelectionForegroundBrush" Value="{StaticResource InkBrush}"/>
</Style>

<!-- Placeholder text -->
<Style Selector="TextBox /template/ TextBlock#Watermark">
    <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
    <Setter Property="FontStyle" Value="Italic"/>
</Style>

<!-- Bauhaus Red accent TextBox -->
<Style Selector="TextBox.accent-red">
    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
</Style>
<Style Selector="TextBox.accent-red:focus">
    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
</Style>

<!-- Bauhaus Blue accent TextBox -->
<Style Selector="TextBox.accent-blue">
    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
</Style>
<Style Selector="TextBox.accent-blue:focus">
    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
</Style>

<!-- Bauhaus Yellow accent TextBox -->
<Style Selector="TextBox.accent-yellow">
    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
</Style>
<Style Selector="TextBox.accent-yellow:focus">
    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
</Style>

<!-- Ghost/flat TextBox (borderless) -->
<Style Selector="TextBox.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,4"/>
</Style>
<Style Selector="TextBox.ghost:focus">
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,3"/>
    <Setter Property="Background" Value="Transparent"/>
</Style>

<!-- Large TextBox for multi-line content -->
<Style Selector="TextBox.large">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="MinHeight" Value="80"/>
</Style>

<!-- Compact TextBox for dense layouts -->
<Style Selector="TextBox.compact">
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="BorderThickness" Value="1.5"/>
</Style>

<!-- Search/filter TextBox style -->
<Style Selector="TextBox.search">
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="10,8,36,8"/>
    <!-- Note: You'd need to add a search icon overlay separately in the  view -->
</Style>


      <!-- Tabs -->
  <Style Selector="TabItem">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2,2,2,0"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
  </Style>


      <!-- Date Picker -->
  <Style Selector="DatePicker">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>

  <!-- Buttons: flat, square, thick ink border, invert on hover -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{StaticResource InkBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <Style Selector="Button.accent-blue">
    <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button.accent-blue:pointerover">
    <Setter Property="Background" Value="{StaticResource InkBrush}"/>
  </Style>

  <Style Selector="Button.accent-red">
    <Setter Property="Background" Value="{StaticResource RedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button.accent-red:pointerover">
    <Setter Property="Background" Value="{StaticResource InkBrush}"/>
  </Style>

  <Style Selector="Button.accent-yellow">
    <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button.accent-yellow:pointerover">
    <Setter Property="Background" Value="{StaticResource InkBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="Button.product-tile">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <!-- Inputs -->
 

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>

  <!-- Cards & rules -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>

  <Style Selector="Border.rule-thick">
    <Setter Property="Background" Value="{StaticResource InkBrush}"/>
    <Setter Property="Height" Value="3"/>
  </Style>

</Styles>