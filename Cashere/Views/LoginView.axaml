<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Cashere.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <UserControl.Styles>
    <!-- Entrance fade for the three signature squares + wordmark/subtitle -
         each starts invisible and fades in on its own Delay once the view
         enters the tree. Deliberately opacity-only (no transform) so the
         animation stays simple and predictable. -->
    <Style Selector="Border.anim-square-1, Border.anim-square-2, Border.anim-square-3, TextBlock.anim-mark, TextBlock.anim-sub">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.anim-square-1">
      <Style.Animations>
        <Animation Duration="0:0:0.5" Delay="0:0:0.1" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.anim-square-2">
      <Style.Animations>
        <Animation Duration="0:0:0.5" Delay="0:0:0.25" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.anim-square-3">
      <Style.Animations>
        <Animation Duration="0:0:0.5" Delay="0:0:0.4" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.anim-mark">
      <Style.Animations>
        <Animation Duration="0:0:0.6" Delay="0:0:0.55" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.anim-sub">
      <Style.Animations>
        <Animation Duration="0:0:0.6" Delay="0:0:0.75" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Gentle ambient pulse on the yellow square once everything has
         settled in, so the panel doesn't feel static while someone types. -->
    <Style Selector="Border.anim-pulse">
      <Style.Animations>
        <Animation Duration="0:0:2.2" Delay="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.5"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Button.keypad">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Height" Value="56"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,460">

    <!-- Left: Bauhaus splash panel -->
    <Border Grid.Column="0" Background="{StaticResource BlueBrush}">
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="64,0,0,0" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
          <Border Width="26" Height="26" Background="{StaticResource RedBrush}" Classes="anim-square-1"/>
          <Border Width="26" Height="26" Background="{StaticResource YellowBrush}" Classes="anim-square-2 anim-pulse"/>
          <Border Width="26" Height="26" Background="{StaticResource InkBrush}" Classes="anim-square-3"/>
        </StackPanel>
        <TextBlock Text="CASHERE" FontSize="64" FontWeight="Black" Foreground="{StaticResource InkBrush}" Classes="anim-mark"/>
        <TextBlock Text="{Binding ShopName, StringFormat='a cashier app for {0}'}"
                   FontSize="16" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Classes="anim-sub"/>
      </StackPanel>
    </Border>

    <!-- Right: login card -->
    <Border Grid.Column="1" Background="{StaticResource BlueBrush}" Padding="40" VerticalAlignment="Center">
      <Border Classes="card" Padding="26">
        <StackPanel Spacing="12">
          <TextBlock Text="GET STARTED" Classes="eyebrow"/>
          <Border Classes="rule-thick"/>

          <TextBlock Text="USERNAME" Classes="eyebrow" FontSize="9"/>
          <TextBox Text="{Binding Username}" Watermark="Username" KeyDown="OnFieldKeyDown">
            <TextBox.InnerLeftContent>
              <mi:MaterialIcon Kind="AccountOutline" Width="16" Height="16" Foreground="{StaticResource GrayBrush}"/>
            </TextBox.InnerLeftContent>
          </TextBox>

          <TextBlock Text="PIN" Classes="eyebrow" FontSize="9"/>
          <TextBox Text="{Binding Pin}" PasswordChar="•" Watermark="PIN" MaxLength="12" KeyDown="OnFieldKeyDown">
            <TextBox.InnerLeftContent>
              <mi:MaterialIcon Kind="LockOutline" Width="16" Height="16" Foreground="{StaticResource GrayBrush}"/>
            </TextBox.InnerLeftContent>
          </TextBox>

          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
            <Button Grid.Row="0" Grid.Column="0" Classes="keypad accent-yellow" Content="1" Command="{Binding AppendDigitCommand}" CommandParameter="1" Margin="0,0,4,4"/>
            <Button Grid.Row="0" Grid.Column="1" Classes="keypad accent-yellow" Content="2" Command="{Binding AppendDigitCommand}" CommandParameter="2" Margin="4,0,4,4"/>
            <Button Grid.Row="0" Grid.Column="2" Classes="keypad accent-yellow" Content="3" Command="{Binding AppendDigitCommand}" CommandParameter="3" Margin="4,0,0,4"/>

            <Button Grid.Row="1" Grid.Column="0" Classes="keypad accent-yellow" Content="4" Command="{Binding AppendDigitCommand}" CommandParameter="4" Margin="0,0,4,4"/>
            <Button Grid.Row="1" Grid.Column="1" Classes="keypad accent-yellow" Content="5" Command="{Binding AppendDigitCommand}" CommandParameter="5" Margin="4,0,4,4"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="keypad accent-yellow" Content="6" Command="{Binding AppendDigitCommand}" CommandParameter="6" Margin="4,0,0,4"/>

            <Button Grid.Row="2" Grid.Column="0" Classes="keypad accent-yellow" Content="7" Command="{Binding AppendDigitCommand}" CommandParameter="7" Margin="0,0,4,4"/>
            <Button Grid.Row="2" Grid.Column="1" Classes="keypad accent-yellow" Content="8" Command="{Binding AppendDigitCommand}" CommandParameter="8" Margin="4,0,4,4"/>
            <Button Grid.Row="2" Grid.Column="2" Classes="keypad accent-yellow" Content="9" Command="{Binding AppendDigitCommand}" CommandParameter="9" Margin="4,0,0,4"/>

            <Button Grid.Row="3" Grid.Column="0" Classes="keypad ghost" Command="{Binding ClearPinCommand}" Margin="0,0,4,0" ToolTip.Tip="Clear">
              <mi:MaterialIcon Kind="CloseCircleOutline" Width="18" Height="18"/>
            </Button>
            <Button Grid.Row="3" Grid.Column="1" Classes="keypad accent-yellow" Content="0" Command="{Binding AppendDigitCommand}" CommandParameter="0" Margin="4,0,4,0"/>
            <Button Grid.Row="3" Grid.Column="2" Classes="keypad ghost" Command="{Binding BackspaceCommand}" Margin="4,0,0,0" ToolTip.Tip="Backspace">
              <mi:MaterialIcon Kind="BackspaceOutline" Width="18" Height="18"/>
            </Button>
          </Grid>

          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold"
                     TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <Button Classes="accent-blue" Command="{Binding LoginCommand}" IsEnabled="{Binding CanSubmit}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,16" FontSize="16" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="LoginVariant" Width="18" Height="18"/>
              <TextBlock Text="LOGIN" IsVisible="{Binding !IsBusy}"/>
              <TextBlock Text="SIGNING IN..." IsVisible="{Binding IsBusy}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>