<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Mobile"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="720"
             x:Class="Cashere.Views.Mobile.PairingView"
             x:DataType="vm:PairingViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="{StaticResource InkBrush}" Padding="18,20">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="14" Height="14" Background="{StaticResource RedBrush}"/>
        <Border Width="14" Height="14" Background="{StaticResource YellowBrush}"/>
        <Border Width="14" Height="14" Background="{StaticResource BlueBrush}"/>
        <StackPanel Margin="10,0,0,0">
          <TextBlock Text="CASHERE" Classes="headline" Foreground="White"/>
          <TextBlock Text="SCANNER" Classes="eyebrow" Foreground="#B8B8B8"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Height="6">
      <Border Grid.Column="0" Background="{StaticResource RedBrush}"/>
      <Border Grid.Column="1" Background="{StaticResource YellowBrush}"/>
      <Border Grid.Column="2" Background="{StaticResource BlueBrush}"/>
    </Grid>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="16" Spacing="16">

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="CONNECTION" Classes="eyebrow"/>
            <TextBlock Text="{Binding State}" FontWeight="Black" FontSize="18"/>
            <TextBlock Text="{Binding ShopName, StringFormat='Shop: {0}'}" IsVisible="{Binding IsConnected}" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding !IsConnected}">
          <TextBlock Text="TILL IP ADDRESS" Classes="eyebrow"/>
          <TextBox Text="{Binding HostInput}" Watermark="192.168.1.42"/>

          <TextBlock Text="PORT" Classes="eyebrow"/>
          <TextBox Text="{Binding PortInput}" Watermark="5177"/>

          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"/>

          <Button Classes="accent-blue" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Padding="0,14" FontSize="16" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="LanConnect" Width="18" Height="18"/>
              <TextBlock Text="CONNECT"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsConnected}">
          <Button Classes="ghost" Command="{Binding DisconnectCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="LanDisconnect" Width="16" Height="16"/>
              <TextBlock Text="DISCONNECT"/>
            </StackPanel>
          </Button>

          <Border Classes="rule-thick"/>

          <StackPanel Spacing="8" IsVisible="{Binding !ShowCameraPreview}">
            <Button Classes="accent-yellow" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Command="{Binding EnableCameraCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="CameraOutline" Width="18" Height="18"/>
                <TextBlock Text="ENABLE CAMERA SCANNING"/>
              </StackPanel>
            </Button>
            <TextBlock Text="Camera permission was denied - use manual entry below, or grant camera access in system settings and reconnect."
                       IsVisible="{Binding CameraPermissionDenied}" Foreground="{StaticResource RedBrush}"
                       TextWrapping="Wrap" FontWeight="Bold"/>
          </StackPanel>

          <Border Classes="card" IsVisible="{Binding ShowCameraPreview}" Height="240" Padding="0" ClipToBounds="True">
            <ContentControl x:Name="CameraPreviewHost"/>
          </Border>

          <TextBlock Text="MANUAL BARCODE (ALWAYS AVAILABLE AS A FALLBACK)" Classes="eyebrow" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding ManualBarcode}" Watermark="Scan or type a barcode">
              <TextBox.InnerLeftContent>
                <mi:MaterialIcon Kind="BarcodeScan" Width="16" Height="16" Foreground="{StaticResource GrayBrush}"/>
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="1" Classes="accent-yellow" Margin="8,0,0,0" Command="{Binding SendManualScanCommand}">
              <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
            </Button>
          </Grid>
          <TextBlock Text="{Binding LastScanMessage}" FontWeight="Bold" TextWrapping="Wrap"/>

          <Border Classes="rule-thick"/>

          <TextBlock Text="LIVE CART" Classes="eyebrow"/>
          <ItemsControl ItemsSource="{Binding CartLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:SyncCartLine">
                <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" FontWeight="Bold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Background="{StaticResource YellowBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="SUBTOTAL" FontWeight="Black" Foreground="{StaticResource InkBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding CartSubtotal, StringFormat='Rp {0:N0}'}" FontWeight="Black" Foreground="{StaticResource InkBrush}"/>
            </Grid>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>  