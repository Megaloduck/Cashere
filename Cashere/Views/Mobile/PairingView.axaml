<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Mobile"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="308" d:DesignHeight="720"
             x:Class="Cashere.Views.Mobile.PairingView"
             x:DataType="vm:PairingViewModel">
  
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Text="CONNECTION" Classes="eyebrow"/>
          <TextBlock Text="{Binding State}" FontWeight="Black" FontSize="18"/>
          <TextBlock Text="{Binding ShopName, StringFormat='Shop: {0}'}" IsVisible="{Binding IsConnected}" FontWeight="Bold"/>
        </StackPanel>
      </Border>

        <StackPanel Spacing="8" IsVisible="{Binding CanScanQr}">
  <Button Classes="accent-yellow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
          Padding="0,14" Command="{Binding StartQrScanCommand}" IsVisible="{Binding !IsScanningQr}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <mi:MaterialIcon Kind="QrcodeScan" Width="18" Height="18"/>
      <TextBlock Text="SCAN TO PAIR"/>
    </StackPanel>
  </Button>

  <Border Classes="card" IsVisible="{Binding IsScanningQr}" Height="240" Padding="0" ClipToBounds="True">
    <ContentControl x:Name="QrPreviewHost"/>
  </Border>

  <Button Classes="ghost" Command="{Binding CancelQrScanCommand}" IsVisible="{Binding IsScanningQr}"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <mi:MaterialIcon Kind="Close" Width="16" Height="16"/>
      <TextBlock Text="CANCEL SCAN"/>
    </StackPanel>
  </Button>

  <Border Classes="rule-thick" Margin="0,4"/>
  <TextBlock Text="OR ENTER MANUALLY" Classes="eyebrow" HorizontalAlignment="Center"/>
</StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding !IsConnected}">
        <TextBlock Text="TILL IP ADDRESS" Classes="eyebrow"/>
        <TextBox Text="{Binding HostInput}" Watermark="192.168.1.42"/>

        <TextBlock Text="PORT" Classes="eyebrow"/>
        <TextBox Text="{Binding PortInput}" Watermark="5177"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap" 
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <Button Classes="accent-blue" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="0,14" FontSize="16" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="LanConnect" Width="18" Height="18"/>
            <TextBlock Text="CONNECT"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding IsConnected}">
        <TextBlock Text="You're connected. Switch to SCAN to start ringing up items, or LABEL to photograph a product."
                   TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}"/>

        <Button Classes="accent-red" Command="{Binding DisconnectCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="LanDisconnect" Width="16" Height="16"/>
            <TextBlock Text="DISCONNECT"/>
          </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>