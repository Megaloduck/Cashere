<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Mobile"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="308" d:DesignHeight="720"
             x:Class="Cashere.Views.Mobile.LabelingView"
             x:DataType="vm:LabelingViewModel">
  
  <Grid>
    <!-- Not connected -->
    <StackPanel Margin="24" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding !IsConnected}">
      <mi:MaterialIcon Kind="LanDisconnect" Width="32" Height="32" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="NOT CONNECTED" Classes="eyebrow" HorizontalAlignment="Center"/>
      <TextBlock Text="Go to the PAIR tab and connect to a till first." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GrayBrush}"/>
    </StackPanel>

    <!-- Product list -->
    <Grid RowDefinitions="Auto,*" Margin="16" IsVisible="{Binding ShowProductList}">
      <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="PICK A PRODUCT TO PHOTOGRAPH" Classes="eyebrow" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
            <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
          </Button>
        </Grid>
        <TextBox Text="{Binding SearchText}" Watermark="Search by name, SKU or barcode">
          <TextBox.InnerLeftContent>
            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="{StaticResource GrayBrush}"/>
          </TextBox.InnerLeftContent>
        </TextBox>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding FilteredProducts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:ProductLookupItem">
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Margin="0,0,0,8" Padding="12,10" Click="OnProductClick">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Sku}" Classes="eyebrow"/>
                  </StackPanel>
                  <mi:MaterialIcon Grid.Column="1" Kind="CheckCircle" Width="18" Height="18"
                                    Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"
                                    IsVisible="{Binding HasPhoto}"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Capture panel -->
    <StackPanel Margin="16" Spacing="12" IsVisible="{Binding ShowCapturePanel}">
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Classes="ghost" Command="{Binding BackToListCommand}" Margin="0,0,8,0">
          <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding SelectedProduct.Name}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>

      <StackPanel Spacing="8" IsVisible="{Binding !ShowCameraPreview}">
        <Button Classes="accent-yellow" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Command="{Binding EnableCameraCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="CameraOutline" Width="18" Height="18"/>
            <TextBlock Text="ENABLE CAMERA"/>
          </StackPanel>
        </Button>
        <TextBlock Text="Camera permission was denied - grant camera access in system settings and try again."
                   IsVisible="{Binding CameraPermissionDenied}" Foreground="{StaticResource RedBrush}"
                   TextWrapping="Wrap" FontWeight="Bold"/>
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding ShowCameraPreview}" Height="380" Padding="0" ClipToBounds="True">
        <ContentControl x:Name="CameraPreviewHost"/>
      </Border>

            <Button Classes="accent-blue" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Padding="0,16" FontSize="16" IsVisible="{Binding ShowCameraPreview}"
              IsEnabled="{Binding IsCameraStarted}" Command="{Binding CaptureCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="Camera" Width="20" Height="20"/>
          <TextBlock Text="TAKE PHOTO"/>
        </StackPanel>
      </Button>

      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Review panel -->
    <StackPanel Margin="16" Spacing="12" IsVisible="{Binding ShowReviewPanel}">
      <TextBlock Text="{Binding SelectedProduct.Name}" FontWeight="Bold" TextWrapping="Wrap"/>

      <Border Classes="card" Height="380" Padding="0" ClipToBounds="True">
        <Image Source="{Binding CapturedImage}" Stretch="UniformToFill"/>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <Grid ColumnDefinitions="*,*">
        <Button Grid.Column="0" Classes="ghost" Command="{Binding RetakeCommand}" IsEnabled="{Binding !IsBusy}"
                Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Restart" Width="16" Height="16"/>
            <TextBlock Text="RETAKE"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="accent-blue" Command="{Binding ConfirmUploadCommand}" IsEnabled="{Binding !IsBusy}"
                Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,14">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18"/>
            <TextBlock Text="UPLOAD"/>
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>