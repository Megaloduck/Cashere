<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Mobile"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="308" d:DesignHeight="720"
             x:Class="Cashere.Views.Mobile.ScanningView"
             x:DataType="vm:ScanningViewModel">
  
  <Grid>
    <!-- Not connected -->
    <StackPanel Margin="24" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding !IsConnected}">
      <mi:MaterialIcon Kind="LanDisconnect" Width="32" Height="32" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="NOT CONNECTED" Classes="eyebrow" HorizontalAlignment="Center"/>
      <TextBlock Text="Go to the PAIR tab and connect to a till first." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GrayBrush}"/>
    </StackPanel>

    <!-- Scanning content -->
    <ScrollViewer IsVisible="{Binding IsConnected}">
      <StackPanel Margin="16" Spacing="16">
          <Border Classes="card" Padding="12">
  <StackPanel Spacing="8">
    <TextBlock Text="QUANTITY PER SCAN" Classes="eyebrow"/>
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Grid.Column="0" Width="40" Height="40" Classes="accent-red" Padding="0"
              Command="{Binding DecrementQuantityCommand}">
        <mi:MaterialIcon Kind="Minus" Width="16" Height="16"/>
      </Button>
      <TextBlock Grid.Column="1" Text="{Binding ScanQuantity}" FontWeight="Black" FontSize="22"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Width="40" Height="40" Classes="accent-yellow" Padding="0"
              Command="{Binding IncrementQuantityCommand}">
        <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
      </Button>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Classes="chip" Content="x1" Command="{Binding QuickQuantity1Command}"/>
      <Button Classes="chip" Content="x5" Command="{Binding QuickQuantity5Command}"/>
      <Button Classes="chip" Content="x10" Command="{Binding QuickQuantity10Command}"/>
    </StackPanel>
  </StackPanel>
</Border>
        <StackPanel Spacing="8" IsVisible="{Binding !ShowCameraPreview}">
          <Button Classes="accent-yellow" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Command="{Binding EnableCameraCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="CameraOutline" Width="18" Height="18"/>
              <TextBlock Text="ENABLE CAMERA SCANNING"/>
            </StackPanel>
          </Button>
          <TextBlock Text="Camera permission was denied - use manual entry below, or grant camera access in system settings and reconnect."
                     IsVisible="{Binding CameraPermissionDenied}" Foreground="{StaticResource RedBrush}"
                     TextWrapping="Wrap" FontWeight="Bold"/>
        </StackPanel>

        <Border Classes="card" IsVisible="{Binding ShowCameraPreview}" Height="240" Padding="0" ClipToBounds="True">
          <ContentControl x:Name="CameraPreviewHost"/>
        </Border>

        <TextBlock Text="MANUAL BARCODE (ALWAYS AVAILABLE AS A FALLBACK)" Classes="eyebrow" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding ManualBarcode}" Watermark="Scan or type a barcode">
            <TextBox.InnerLeftContent>
              <mi:MaterialIcon Kind="BarcodeScan" Width="16" Height="16" Foreground="{StaticResource GrayBrush}" Margin="8,0,0,0"/>
            </TextBox.InnerLeftContent>
          </TextBox>
          <Button Grid.Column="1" Classes="accent-yellow" Margin="8,0,0,0" Command="{Binding SendManualScanCommand}">
            <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
          </Button>
        </Grid>
        <TextBlock Text="{Binding LastScanMessage}" FontWeight="Bold" TextWrapping="Wrap" 
                    IsVisible="{Binding LastScanMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <Border Classes="card" Padding="12" IsVisible="{Binding HasScannedProduct}">
          <StackPanel Spacing="8">
            <TextBlock Text="SCANNED PRODUCT" Classes="eyebrow"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding ScannedProductName}" FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="{Binding ScannedProductUnitPrice, StringFormat='Rp {0:N0}'}" FontWeight="Bold" Margin="8,0,0,0"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Grid.Column="0" Width="38" Height="38" Classes="accent-red" Padding="0"
                      Command="{Binding DecrementScannedProductQuantityCommand}">
                <mi:MaterialIcon Kind="Minus" Width="15" Height="15"/>
              </Button>
              <TextBlock Grid.Column="1" Text="{Binding ScannedProductQuantity, StringFormat='Quantity: {0}'}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
              <Button Grid.Column="2" Width="38" Height="38" Classes="accent-yellow" Padding="0"
                      Command="{Binding IncrementScannedProductQuantityCommand}">
                <mi:MaterialIcon Kind="Plus" Width="15" Height="15"/>
              </Button>
            </Grid>
            <Button Classes="accent-blue" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,12" Command="{Binding SendToCartCommand}" IsEnabled="{Binding !IsSendingToCart}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="CartArrowDown" Width="18" Height="18"/>
                <TextBlock Text="SEND TO CART"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="rule-thick"/>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="LIVE CART" Classes="eyebrow" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="accent-red" Padding="8,4" Command="{Binding ClearCartCommand}"
                  IsEnabled="{Binding HasCartLines}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <mi:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14"/>
              <TextBlock Text="CLEAR CART" FontSize="10"/>
            </StackPanel>
          </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding CartLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:SyncCartLine">
              <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="Bold" TextWrapping="Wrap"/>
                  <Button Grid.Column="1" Width="30" Height="30" Classes="accent-red" Padding="0" Margin="4,0"
                          Command="{Binding $parent[ItemsControl].((vm:ScanningViewModel)DataContext).DecrementCartItemCommand}"
                          CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Minus" Width="13" Height="13"/>
                  </Button>
                  <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='x{0}'}" Margin="4,0" VerticalAlignment="Center"/>
                  <Button Grid.Column="3" Width="30" Height="30" Classes="accent-red" Padding="0" Margin="4,0"
                          Command="{Binding $parent[ItemsControl].((vm:ScanningViewModel)DataContext).ClearCartItemCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="Remove product">
                    <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13"/>
                  </Button>
                  <TextBlock Grid.Column="4" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="{StaticResource YellowBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="10,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="SUBTOTAL" FontWeight="Black" Foreground="{StaticResource InkBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding CartSubtotal, StringFormat='Rp {0:N0}'}" FontWeight="Black" Foreground="{StaticResource InkBrush}"/>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
