<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Mobile"
             xmlns:converters="clr-namespace:Cashere.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="720"
             x:Class="Cashere.Views.Mobile.MobileShellView"
             x:DataType="vm:MobileShellViewModel">

  <UserControl.Resources>
    <converters:EnumMatchConverter x:Key="EnumMatch"/>
    <converters:EnumToTitleConverter x:Key="EnumToTitle"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">
    
    <!-- SHELL HEADER - Row 0 -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" 
            Background="{StaticResource InkBrush}" 
            Padding="18,12">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="14" Height="14" Background="{StaticResource RedBrush}"/>
          <Border Width="14" Height="14" Background="{StaticResource YellowBrush}"/>
          <Border Width="14" Height="14" Background="{StaticResource BlueBrush}"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="CASHERE" Classes="headline" Foreground="White"/>
            <TextBlock Text="{Binding SelectedSection, Converter={StaticResource EnumToTitle}}" 
                       Classes="eyebrow" Foreground="#B8B8B8"/>
          </StackPanel>
        </StackPanel>
        
        <!-- Menu button locked in header -->
        <Button Classes="ghost" 
                Command="{Binding ToggleSidebarCommand}"
                IsVisible="{Binding !IsSidebarVisible}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Margin="0,0,4,0" 
                Padding="8"
                Background="Transparent"
                CornerRadius="{StaticResource RadiusMedium}">
          <mi:MaterialIcon Kind="Menu" Width="22" Height="22" Foreground="White"/>
        </Button>
      </Grid>
    </Border>

    <!-- TRI-COLOR STRIP - Row 1 -->
    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" Height="4">
      <Border Grid.Column="0" Background="{StaticResource RedBrush}"/>
      <Border Grid.Column="1" Background="{StaticResource YellowBrush}"/>
      <Border Grid.Column="2" Background="{StaticResource BlueBrush}"/>
    </Grid>

    <!-- CONTENT - Row 2 -->
    <ContentControl Grid.Row="2" Grid.Column="0" 
                    Content="{Binding CurrentView}"/>

    <!-- SIDEBAR - Row 2, Column 1 -->
    <Border Grid.Row="2" Grid.Column="1" 
            Background="{StaticResource InkBrush}" 
            Width="72" 
            IsVisible="{Binding IsSidebarVisible}">
      <StackPanel Margin="0,16,0,0" Spacing="4">
        <Button Classes="rail-item" 
                Classes.selected="{Binding SelectedSection, Converter={StaticResource EnumMatch}, ConverterParameter=Pairing}"
                Command="{Binding SelectSectionCommand}" 
                CommandParameter="{x:Static vm:MobileSection.Pairing}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="LanConnect" Width="22" Height="22" HorizontalAlignment="Center"/>
            <TextBlock Text="PAIR" Classes="rail-label" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Classes="rail-item" 
                Classes.selected="{Binding SelectedSection, Converter={StaticResource EnumMatch}, ConverterParameter=Scanning}"
                Command="{Binding SelectSectionCommand}" 
                CommandParameter="{x:Static vm:MobileSection.Scanning}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="BarcodeScan" Width="22" Height="22" HorizontalAlignment="Center"/>
            <TextBlock Text="SCAN" Classes="rail-label" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Classes="rail-item" 
                Classes.selected="{Binding SelectedSection, Converter={StaticResource EnumMatch}, ConverterParameter=Labeling}"
                Command="{Binding SelectSectionCommand}" 
                CommandParameter="{x:Static vm:MobileSection.Labeling}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="CameraPlusOutline" Width="22" Height="22" HorizontalAlignment="Center"/>
            <TextBlock Text="LABEL" Classes="rail-label" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Border Height="2" Background="#2A2A2A" Margin="16,10"/>

        <Button Classes="rail-item" Command="{Binding ToggleSidebarCommand}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="ArrowRight" Width="22" Height="22" HorizontalAlignment="Center"/>
            <TextBlock Text="HIDE" Classes="rail-label" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>  