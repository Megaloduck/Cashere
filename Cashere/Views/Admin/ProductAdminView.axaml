<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             xmlns:models="clr-namespace:Cashere.Models"
             xmlns:converters="clr-namespace:Cashere.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Cashere.Views.Admin.ProductAdminView"
             x:DataType="vm:ProductAdminViewModel">
  <UserControl.Resources>
    <converters:PhotoPathToImageConverter x:Key="PhotoPathToImage"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12">
    <!-- Header Section (Unchanged) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto,Auto,Auto"  Margin="0,0,0,12">
        <TextBlock Grid.Column="0" Text="PRODUCTS" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Watermark="SEARCH BY NAME, SKU OR BARCODE..." Text="{Binding SearchText}" Margin="0,0,12,0">
        <TextBox.InnerLeftContent>
          <mi:MaterialIcon Kind="Magnify" Width="16" Height="16"  Margin="12,0,0,0" Foreground="{StaticResource GrayBrush}"/>
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="2" Classes="chip" Click="OnImportCatalogClick" IsVisible="{Binding CanManage}" IsEnabled="{Binding !IsDataTransferBusy}" Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Import" Width="16" Height="16"/>
          <TextBlock Text="IMPORT CSV"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="chip" Click="OnExportCatalogClick" IsVisible="{Binding CanManage}" IsEnabled="{Binding !IsDataTransferBusy}" Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Export" Width="16" Height="16"/>
          <TextBlock Text="EXPORT CSV"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="accent-blue" Command="{Binding AddNewCommand}" IsVisible="{Binding CanManage}" >
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
          <TextBlock Text="NEW PRODUCT"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- List Header (Unchanged) -->
    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding CanManage}">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanManage}">
        <TextBlock Grid.Column="0" Text="Matching SKUs are skipped by default. Enable updates to replace catalog fields; existing stock counts are always preserved." TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="UPDATE MATCHES" Classes="eyebrow" FontSize="9"/>
          <ToggleSwitch IsChecked="{Binding UpdateExistingProducts}"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding DataTransferStatus}" TextWrapping="Wrap" Foreground="{StaticResource BlueBrush}" FontWeight="Bold"
                 IsVisible="{Binding DataTransferStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="48,2*,1*,1.2*,1*,1*,1*,190" Margin="0,0,0,4">
      <TextBlock Grid.Column="1" Text="NAME" Classes="eyebrow"/>
      <TextBlock Grid.Column="2" Text="SKU" Classes="eyebrow"/>
      <TextBlock Grid.Column="3" Text="BARCODE" Classes="eyebrow"/>
      <TextBlock Grid.Column="4" Text="PRICE" Classes="eyebrow"/>
      <TextBlock Grid.Column="5" Text="STOCK" Classes="eyebrow"/>
      <TextBlock Grid.Column="6" Text="STATUS" Classes="eyebrow"/>
      <TextBlock Grid.Column="7" Text="ACTIONS" Classes="eyebrow"/>
    </Grid>
    <Border Grid.Row="2" Classes="rule-thick" VerticalAlignment="Bottom"/>

    <!-- List Content (Unchanged) -->
    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding FilteredProducts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Product">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,10">
              <Grid ColumnDefinitions="48,2*,1*,1.2*,1*,1*,1*,190">
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusSmall}"
                        Background="{StaticResource GrayLightBrush}" ClipToBounds="True" VerticalAlignment="Center">
                  <Grid>
                    <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoPathToImage}}"
                           IsVisible="{Binding PhotoPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Stretch="UniformToFill"/>
                    <mi:MaterialIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="{StaticResource GrayBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsVisible="{Binding PhotoPath, Converter={x:Static ObjectConverters.IsNull}}"/>
                  </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Sku}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding Barcode, TargetNullValue='—'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding SellingPrice, StringFormat='Rp {0:N0}'}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding StockQuantity}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                  <TextBlock Text="ACTIVE" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" IsVisible="{Binding IsActive}"/>
                  <TextBlock Text="INACTIVE" Foreground="{StaticResource RedBrush}" FontWeight="Bold" IsVisible="{Binding !IsActive}"/>
                </StackPanel>
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding $parent[UserControl].((vm:ProductAdminViewModel)DataContext).CanManage}">
                  <Button Classes="ghost" Click="OnEditClick" ToolTip.Tip="Edit">
                    <mi:MaterialIcon Kind="PencilOutline" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnToggleActiveClick" IsVisible="{Binding IsActive}" ToolTip.Tip="Deactivate">
                    <mi:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnToggleActiveClick" IsVisible="{Binding !IsActive}" ToolTip.Tip="Reactivate">
                    <mi:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnRemovePhotoClick"
                          IsVisible="{Binding PhotoPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ToolTip.Tip="Remove photo">
                    <mi:MaterialIcon Kind="ImageRemoveOutline" Width="16" Height="16"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- MODIFIED: Add New Product Form Overlay -->
    <Border Grid.RowSpan="3" Background="#CC141414" IsVisible="{Binding IsEditorOpen}">

      <!-- Add New Product Form -->
      <!-- Increased width to 800 to accommodate the side-by-side layout -->
      <Border Classes="card" Width="800" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="15">
            <!-- Header -->
            <TextBlock Text="{Binding EditorTitle}" Classes="headline" FontSize="18"/>
            <Border Classes="rule-thick"/>

            <!-- Main Content Grid: Left (Images) vs Right (Fields) -->
            <Grid ColumnDefinitions="220, *">

              <!-- LEFT COLUMN: Image Uploads -->
              <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,20,0">

                <!-- Product Photo Section -->
                <StackPanel Spacing="5">
                  <TextBlock Text="PRODUCT PHOTO" Classes="eyebrow"/>
                  <Border BorderBrush="{StaticResource GrayBrush}" BorderThickness="1" CornerRadius="8"
                          Height="180" Background="{StaticResource GrayLightBrush}" ClipToBounds="True">
                    <Grid>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5"
                                  IsVisible="{Binding !HasFormPhotoPreview}">
                        <mi:MaterialIcon Kind="Upload" Width="32" Height="32" Foreground="{StaticResource GrayBrush}"/>
                        <TextBlock Text="Choose a photo" HorizontalAlignment="Center" Foreground="{StaticResource GrayBrush}"/>
                      </StackPanel>
                      <Image Source="{Binding FormPhotoPreview}" Stretch="UniformToFill"
                             IsVisible="{Binding HasFormPhotoPreview}"/>
                      <Button Background="Transparent" Click="OnPickProductPhotoClick"
                              ToolTip.Tip="Choose a product photo"/>
                    </Grid>
                  </Border>
                  <TextBlock Text="Saved with the product. PNG, JPG, or WebP, up to 10 MB."
                             FontSize="10" Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="AUTO-GENERATED CASHERE QR IDENTITY" Classes="eyebrow" TextWrapping="Wrap"/>
                  <Border BorderBrush="{StaticResource GrayBrush}" BorderThickness="1" CornerRadius="8"
                          Height="180" Background="{StaticResource GrayLightBrush}" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="Save the product to generate its unique QR identity."
                                 TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="14" Foreground="{StaticResource GrayBrush}"
                                 IsVisible="{Binding !HasFormQrPreview}"/>
                      <Image Source="{Binding FormQrPreview}" Width="148" Height="148"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding HasFormQrPreview}"/>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding FormQrIdentity}" FontSize="10"
                             Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap"
                             IsVisible="{Binding HasFormQrPreview}"/>
                  <TextBlock Text="Scan this Cashere identity to add the product to the shared cart."
                             FontSize="10" Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap"
                             IsVisible="{Binding HasFormQrPreview}"/>
                </StackPanel>
              </StackPanel>

              <!-- RIGHT COLUMN: Form Fields -->
              <StackPanel Grid.Column="1" Spacing="12">

                <!-- Name -->
                <StackPanel Spacing="2">
                  <TextBlock Text="NAME" Classes="eyebrow"/>
                  <TextBox Text="{Binding FormName}"/>
                </StackPanel>

                <!-- SKU -->
                <StackPanel Spacing="2">
                  <TextBlock Text="SKU" Classes="eyebrow"/>
                  <TextBox Text="{Binding FormSku}" Watermark="Leave blank to auto-generate (Settings → Inventory)" />
                </StackPanel>

                <!-- Barcode -->
                <StackPanel Spacing="2">
                  <TextBlock Text="BARCODE" Classes="eyebrow"/>
                  <TextBox Text="{Binding FormBarcode}" Watermark="Leave blank to auto-generate (Settings → Inventory)"/>
                  <TextBlock Text="Leave blank to auto-generate (Settings → Inventory)" FontSize="10" Foreground="{StaticResource GrayBrush}"
                             IsVisible="{Binding AutoGenerateBarcodeEnabled}"/>
                </StackPanel>

                <!-- Category -->
                <StackPanel Spacing="2">
                  <TextBlock Text="CATEGORY" Classes="eyebrow"/>
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FormCategory}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <!-- Add Category Row -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBox Grid.Column="0" Text="{Binding NewCategoryName}" Watermark="New category name"/>
                    <Button Grid.Column="1" Classes="accent-yellow" Margin="8,0,0,0" Command="{Binding AddCategoryCommand}">
                      <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                    </Button>
                  </Grid>
                </StackPanel>

                <!-- Unit -->
                <StackPanel Spacing="2">
                  <TextBlock Text="UNIT" Classes="eyebrow"/>
                  <TextBox Text="{Binding FormUnit}"/>
                </StackPanel>

                <!-- Cost & Selling Price -->
                <Grid ColumnDefinitions="*,*">
                  <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                    <TextBlock Text="COST PRICE" Classes="eyebrow"/>
                    <TextBox Text="{Binding FormCostPrice}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                    <TextBlock Text="SELLING PRICE" Classes="eyebrow"/>
                    <TextBox Text="{Binding FormSellingPrice}"/>
                  </StackPanel>
                </Grid>

                <!-- Stock & Low Stock Alert -->
                <Grid ColumnDefinitions="*,*">
                  <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                    <TextBlock Text="STOCK QUANTITY" Classes="eyebrow"/>
                    <TextBox Text="{Binding FormStockQuantity}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                    <TextBlock Text="LOW STOCK ALERT" Classes="eyebrow"/>
                    <TextBox Text="{Binding FormLowStockThreshold}"/>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="2">
                  <TextBlock Text="OUT-OF-STOCK BEHAVIOR" Classes="eyebrow"/>
                  <ComboBox ItemsSource="{Binding OutOfStockOptions}" SelectedItem="{Binding FormOutOfStockOption}" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="Use shop default unless this product needs a different rule."
                             FontSize="10" Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="TAX RATE OVERRIDE" Classes="eyebrow"/>
                  <TextBox Text="{Binding FormTaxRateOverridePercent}" Watermark="Leave blank to inherit"/>
                  <TextBlock Text="Enter a percentage from 0 to 100. Blank uses the category rate, then the shop rate."
                             FontSize="10" Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Grid>

            <!-- Action Buttons (Bottom) -->
            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
              <Button Grid.Column="0" Content="CANCEL" Classes="accent-red" Command="{Binding CancelEditCommand}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
              <Button Grid.Column="1" Content="SAVE" Classes="accent-blue" Command="{Binding SaveCommand}"
                      Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
