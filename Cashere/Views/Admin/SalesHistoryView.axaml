<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="640"
             x:Class="Cashere.Views.Admin.SalesHistoryView"
             x:DataType="vm:SalesHistoryViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12">
    <TextBlock Grid.Row="0" Text="SALES HISTORY" Classes="headline" FontSize="18" Margin="0,0,0,12"/>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
        <TextBlock Text="FROM" Classes="eyebrow"/>
        <DatePicker SelectedDate="{Binding FromDate}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0">
        <TextBlock Text="TO" Classes="eyebrow"/>
        <DatePicker SelectedDate="{Binding ToDate}"/>
      </StackPanel>
      <Button Grid.Column="2" Classes="chip" VerticalAlignment="Bottom" Margin="0,0,8,0" Command="{Binding SetTodayCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="CalendarToday" Width="14" Height="14"/>
          <TextBlock Text="TODAY"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="chip" VerticalAlignment="Bottom" Margin="0,0,8,0" Command="{Binding SetThisWeekCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="CalendarRange" Width="14" Height="14"/>
          <TextBlock Text="THIS WEEK"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="chip" VerticalAlignment="Bottom" Command="{Binding SetThisMonthCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="CalendarMonth" Width="14" Height="14"/>
          <TextBlock Text="THIS MONTH"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="5" Classes="accent-blue" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
          <TextBlock Text="REFRESH"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="150,1.3*,0.8*,0.8*,60,90,110,160" Margin="0,0,0,4">
      <TextBlock Grid.Column="0" Text="DATE" Classes="eyebrow"/>
      <TextBlock Grid.Column="1" Text="SALE #" Classes="eyebrow"/>
      <TextBlock Grid.Column="2" Text="CASHIER" Classes="eyebrow"/>
      <TextBlock Grid.Column="3" Text="CUSTOMER" Classes="eyebrow"/>
      <TextBlock Grid.Column="4" Text="ITEMS" Classes="eyebrow"/>
      <TextBlock Grid.Column="5" Text="STATUS" Classes="eyebrow"/>
      <TextBlock Grid.Column="6" Text="TOTAL" Classes="eyebrow"/>
      <TextBlock Grid.Column="7" Text="ACTIONS" Classes="eyebrow"/>
    </Grid>
    <Border Grid.Row="2" Classes="rule-thick" VerticalAlignment="Bottom"/>

    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding Sales}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:SaleListItem">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,10">
              <Grid ColumnDefinitions="150,1.3*,0.8*,0.8*,60,90,110,160">
                <TextBlock Grid.Column="0" Text="{Binding SaleDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SaleNumber}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding CashierName}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding CustomerName}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding Status}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding TotalAmount, StringFormat='Rp {0:N0}'}" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                  <Button Classes="ghost" Click="OnViewClick" ToolTip.Tip="View">
                    <mi:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnRefundClick" ToolTip.Tip="Refund"
                          IsVisible="{Binding $parent[UserControl].((vm:SalesHistoryViewModel)DataContext).CanManage}">
                    <mi:MaterialIcon Kind="CashRefund" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnVoidClick" ToolTip.Tip="Void sale"
                          IsVisible="{Binding $parent[UserControl].((vm:SalesHistoryViewModel)DataContext).CanManage}">
                    <mi:MaterialIcon Kind="CancelOutline" Width="16" Height="16" Foreground="{StaticResource RedBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.RowSpan="4" Background="#CC141414" IsVisible="{Binding IsDetailOpen}">
      <Border Classes="card" Width="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <ScrollViewer MaxHeight="500">
            <StackPanel Spacing="12" DataContext="{Binding SelectedSaleDetail}" x:DataType="services:SaleDetail">
              <TextBlock Text="{Binding SaleNumber, StringFormat='SALE {0}'}" Classes="headline" FontSize="18"/>
              <TextBlock Text="{Binding SaleDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Classes="eyebrow"/>
              <Border Classes="rule-thick"/>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="CASHIER"/>
                <TextBlock Grid.Column="1" Text="{Binding CashierName}" FontWeight="Bold"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="CUSTOMER"/>
                <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontWeight="Bold"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="STATUS"/>
                <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="Bold"/>
              </Grid>

              <Border Classes="rule-thick"/>
              <TextBlock Text="ITEMS" Classes="eyebrow"/>
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:SaleLineDetail">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" Margin="8,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" FontWeight="Bold"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="rule-thick"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="SUBTOTAL"/>
                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="DISCOUNT"/>
                <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='Rp {0:N0}'}"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="TAX"/>
                <TextBlock Grid.Column="1" Text="{Binding TaxAmount, StringFormat='Rp {0:N0}'}"/>
              </Grid>
              <Border Background="{StaticResource YellowBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="10,8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="TOTAL" FontWeight="Black" Foreground="Black"/>
                  <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='Rp {0:N0}'}" FontWeight="Black" Foreground="Black"/>
                </Grid>
              </Border>

              <Border Classes="rule-thick"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="GROSS PROFIT" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding GrossProfit, StringFormat='Rp {0:N0}'}" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
              </Grid>

              <Border Classes="rule-thick"/>
              <TextBlock Text="PAYMENTS" Classes="eyebrow"/>
              <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:SalePaymentDetail">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Method}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='Rp {0:N0}'}" FontWeight="Bold"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="rule-thick"/>
              <TextBlock Text="REFUND / VOID HISTORY" Classes="eyebrow"/>
              <ItemsControl ItemsSource="{Binding Refunds}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:RefundHistoryEntry">
                    <Grid ColumnDefinitions="70,*,Auto" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="VOIDED" FontWeight="Black" FontSize="10" Foreground="{StaticResource RedBrush}" IsVisible="{Binding IsVoid}"/>
                      <TextBlock Grid.Column="0" Text="REFUND" FontWeight="Black" FontSize="10" Foreground="{StaticResource BlueBrush}" IsVisible="{Binding !IsVoid}"/>
                      <StackPanel Grid.Column="1" Spacing="1" Margin="6,0">
                        <TextBlock Text="{Binding ProcessedByName}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding RefundDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" FontSize="9" Foreground="{StaticResource GrayBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='Rp {0:N0}'}" FontWeight="Bold" VerticalAlignment="Top"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Grid ColumnDefinitions="*,*" IsVisible="{Binding CanManage}">
            <Button Grid.Column="0" Classes="accent-yellow" Command="{Binding OpenRefundDialogCommand}" Margin="0,0,4,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CashRefund" Width="16" Height="16"/>
                <TextBlock Text="REFUND"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="accent-red" Command="{Binding OpenVoidPromptCommand}" Margin="4,0,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CancelOutline" Width="16" Height="16"/>
                <TextBlock Text="VOID SALE"/>
              </StackPanel>
            </Button>
          </Grid>

          <Button Classes="accent-blue  " Command="{Binding CloseDetailCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="Close" Width="16" Height="16"/>
              <TextBlock Text="CLOSE"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#CC141414" IsVisible="{Binding IsRefundDialogOpen}">
      <Border Classes="card" Width="560" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="REFUND ITEMS" Classes="headline" FontSize="18"/>
          <Border Classes="rule-thick"/>

          <Grid ColumnDefinitions="*,60,70,70,90,80">
            <TextBlock Grid.Column="0" Text="PRODUCT" Classes="eyebrow"/>
            <TextBlock Grid.Column="1" Text="ORIG" Classes="eyebrow"/>
            <TextBlock Grid.Column="2" Text="DONE" Classes="eyebrow"/>
            <TextBlock Grid.Column="3" Text="LEFT" Classes="eyebrow"/>
            <TextBlock Grid.Column="4" Text="PRICE" Classes="eyebrow"/>
            <TextBlock Grid.Column="5" Text="QTY" Classes="eyebrow"/>
          </Grid>
          <Border Classes="rule-thick"/>

          <ScrollViewer MaxHeight="320">
            <ItemsControl ItemsSource="{Binding RefundLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RefundLineFormItem">
                  <Grid ColumnDefinitions="*,60,70,70,90,80" Margin="0,6">
                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding OriginalQuantity}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding AlreadyRefundedQuantity}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding RefundableQuantity}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="{Binding UnitPrice, StringFormat='Rp {0:N0}'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="5" Text="{Binding RefundQuantity}" Classes="compact"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Text="REASON (OPTIONAL)" Classes="eyebrow"/>
          <TextBox Text="{Binding RefundReason}" AcceptsReturn="True" Height="50"/>

          <TextBlock Text="{Binding RefundErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"
                     IsVisible="{Binding RefundErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="CANCEL" Classes="accent-red" Command="{Binding CancelRefundCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Grid.Column="1" Classes="accent-blue" Command="{Binding ProcessRefundCommand}" IsEnabled="{Binding !IsProcessingRefund}"
                    Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="PROCESS REFUND" IsVisible="{Binding !IsProcessingRefund}"/>
                <TextBlock Text="PROCESSING..." IsVisible="{Binding IsProcessingRefund}"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#CC141414" IsVisible="{Binding IsVoidPromptOpen}">
      <Border Classes="card" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="{StaticResource RedBrush}"/>
            <TextBlock Text="VOID SALE" Classes="headline" FontSize="18"/>
          </StackPanel>
          <Border Classes="rule-thick"/>
          <TextBlock Text="This cancels everything still refundable on this sale and returns the stock. It can't be undone."
                     TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"/>

          <TextBlock Text="REASON (OPTIONAL)" Classes="eyebrow"/>
          <TextBox Text="{Binding VoidReason}" AcceptsReturn="True" Height="50"/>

          <TextBlock Text="{Binding VoidErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"
                     IsVisible="{Binding VoidErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="CANCEL" Classes="ghost" Command="{Binding CancelVoidCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Grid.Column="1" Classes="accent-red" Command="{Binding ConfirmVoidCommand}" IsEnabled="{Binding !IsProcessingVoid}"
                    Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CancelOutline" Width="16" Height="16"/>
                <TextBlock Text="CONFIRM VOID" IsVisible="{Binding !IsProcessingVoid}"/>
                <TextBlock Text="VOIDING..." IsVisible="{Binding IsProcessingVoid}"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>