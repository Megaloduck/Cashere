<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             xmlns:views="clr-namespace:Cashere.Views.Admin"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Cashere.Views.Admin.AdminView"
             x:DataType="vm:AdminViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="{StaticResource InkBrush}" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="14" Height="14" Background="{StaticResource RedBrush}"/>
          <Border Width="14" Height="14" Background="{StaticResource YellowBrush}"/>
          <Border Width="14" Height="14" Background="{StaticResource BlueBrush}"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="CASHERE" Classes="headline" Foreground="White"/>
            <TextBlock Text="ADMIN" Classes="eyebrow" Foreground="#B8B8B8"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="BACK TO POS" Classes="accent-yellow" Command="{Binding BackCommand}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Height="6">
      <Border Grid.Column="0" Background="{StaticResource RedBrush}"/>
      <Border Grid.Column="1" Background="{StaticResource YellowBrush}"/>
      <Border Grid.Column="2" Background="{StaticResource BlueBrush}"/>
    </Grid>

        <TabControl Grid.Row="2" Margin="16">
      <TabItem Header="PRODUCTS">
        <views:ProductAdminView DataContext="{Binding Products}"/>
      </TabItem>
      <TabItem Header="PURCHASES">
        <views:PurchaseAdminView DataContext="{Binding Purchases}"/>
      </TabItem>
      <TabItem Header="SUPPLIERS">
        <views:SupplierAdminView DataContext="{Binding Suppliers}"/>
      </TabItem>
      <TabItem Header="CASHIERS">
        <views:CashierAdminView DataContext="{Binding Cashiers}"/>
      </TabItem>
      <TabItem Header="SHOP SETTINGS">
        <views:ShopSettingsView DataContext="{Binding Settings}"/>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>