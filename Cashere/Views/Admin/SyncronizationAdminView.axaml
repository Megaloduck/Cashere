<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Cashere.Views.Admin.SyncronizationAdminView"
             x:DataType="vm:SyncronizationAdminViewModel">

    <Grid RowDefinitions="Auto,*" Margin="12">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="SYNCHRONIZATION" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
            <Border Classes="rule-thick"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">

                <!-- Pairing QR code -->
                <StackPanel Spacing="8"
                            IsVisible="{Binding IsPairingQrCodeAvailable}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                    <TextBlock Text="SCAN TO PAIR A PHONE" Classes="eyebrow" HorizontalAlignment="Center"/>
                    <Border Classes="card" Padding="12" Width="180" Height="180">
                        <Image Source="{Binding PairingQrCodeImage}" Stretch="Uniform"/>
                    </Border>
                </StackPanel>

                <Border Classes="rule-thick"
                        Margin="0,4"
                        IsVisible="{Binding IsPairingQrCodeAvailable}"/>

                <!-- Bind address -->
                <TextBlock Text="BIND ADDRESS" Classes="eyebrow"/>
                <ComboBox ItemsSource="{Binding AvailableBindAddresses}"
                          SelectedItem="{Binding ServerBindAddress}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock Text="0.0.0.0 binds every network adapter on this PC - the safe default. Pick a specific address only to restrict which network the till is reachable on."
                           Foreground="{StaticResource GrayBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"/>

                <!-- Port -->
                <TextBlock Text="PORT" Classes="eyebrow"/>
                <TextBox Text="{Binding ServerPort}" Watermark="5177"/>

                <TextBlock Text="Changes take effect the next time Cashere is started."
                           Foreground="{StaticResource GrayBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"/>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BlueBrush}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Save -->
                <Button Content="SAVE SETTINGS"
                        Classes="accent-blue"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,14"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>