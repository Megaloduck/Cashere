<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Cashere.Views.Admin.ReceiptAdminView"
             x:DataType="vm:ReceiptAdminViewModel">
    <Grid RowDefinitions="Auto,*" Margin="12">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock  Text="RECEIPT CONFIGURATIONS" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
                <Border Classes="rule-thick"/>
            </StackPanel>            
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,1*">
            <!-- Receipt Configuration (scrollable) -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,12,0">
                <StackPanel Spacing="10">
                    
                    <TextBlock Text="SHOP NAME" Classes="eyebrow"/>
                    <TextBox Text="{Binding ShopName}"/>

                    <TextBlock Text="ADDRESS" Classes="eyebrow"/>
                    <TextBox Text="{Binding Address}"/>

                    <TextBlock Text="PHONE" Classes="eyebrow"/>
                    <TextBox Text="{Binding Phone}"/>

                    <TextBlock Text="CURRENCY CODE" Classes="eyebrow"/>
                    <TextBox Text="{Binding Currency}"/>

                    <TextBlock Text="TAX RATE (%)" Classes="eyebrow"/>
                    <TextBox Text="{Binding TaxRatePercent}"/>

                    <TextBlock Text="RECEIPT FOOTER TEXT" Classes="eyebrow"/>
                    <TextBox Text="{Binding ReceiptFooterText}" AcceptsReturn="True" Height="70"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BlueBrush}"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <Button Content="SAVE SETTINGS"
                            Classes="accent-blue"
                            Command="{Binding SaveCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,14"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Receipt Preview -->
            <ScrollViewer Grid.Column="1" >
                
                <StackPanel Spacing="10">

              <Grid ColumnDefinitions="Auto,*" MaxWidth="300" HorizontalAlignment="Center">
                <TextBlock Grid.Column="0" Text="RECEIPT PREVIEW" Classes="eyebrow" VerticalAlignment="Center"/>
              </Grid>

              <StackPanel MaxWidth="300" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="PREVIEW AS PAYMENT METHOD" Classes="eyebrow" FontSize="9"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PreviewPaymentMethod}"
                          HorizontalAlignment="Stretch"/>
              </StackPanel>

              <Border Classes="card" Padding="0" MaxWidth="300" HorizontalAlignment="Center" ClipToBounds="True">
                <StackPanel Background="White">

                  <!-- Shop header -->
                  <StackPanel Margin="20,22,20,10" Spacing="3">
                    <TextBlock Text="{Binding ShopName}" FontFamily="Consolas,Courier New,monospace"
                               FontWeight="Black" FontSize="15" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Address}" FontFamily="Consolas,Courier New,monospace"
                               FontSize="10.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding Address, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding Phone}" FontFamily="Consolas,Courier New,monospace"
                               FontSize="10.5" HorizontalAlignment="Center"
                               IsVisible="{Binding Phone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <TextBlock Text="------------------------------------"
                             FontFamily="Consolas,Courier New,monospace" FontSize="10"
                             Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                  <!-- Date / receipt number / cashier -->
                  <StackPanel Margin="20,0,20,8" Spacing="2">
                    <Grid ColumnDefinitions="*,*">
                      <TextBlock Grid.Column="0" Text="{Binding PreviewDateTime}"
                                 FontFamily="Consolas,Courier New,monospace" FontSize="10"
                                 Foreground="{StaticResource GrayBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewReceiptNumber}"
                                 FontFamily="Consolas,Courier New,monospace" FontSize="10"
                                 Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="{Binding PreviewCashierName, StringFormat='Cashier: {0}'}"
                               FontFamily="Consolas,Courier New,monospace" FontSize="10"
                               Foreground="{StaticResource GrayBrush}"/>
                  </StackPanel>

                  <TextBlock Text="------------------------------------"
                             FontFamily="Consolas,Courier New,monospace" FontSize="10"
                             Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                  <!-- Sample line items -->
                  <ItemsControl ItemsSource="{Binding PreviewLines}" Margin="20,0,20,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReceiptPreviewLine">
                        <StackPanel Margin="0,0,0,6">
                          <TextBlock Text="{Binding Name}" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='  {0} x'}"
                                       FontFamily="Consolas,Courier New,monospace" FontSize="10.5"
                                       Foreground="{StaticResource GrayBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:N0}}"
                                       FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="------------------------------------"
                             FontFamily="Consolas,Courier New,monospace" FontSize="10"
                             Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                  <!-- Subtotal / tax / total -->
                  <StackPanel Margin="20,0,20,10" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="SUBTOTAL" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewSubtotalDisplay}" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding PreviewTaxLabel}" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewTaxDisplay}" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                    </Grid>
                  </StackPanel>

                  <!-- Total -->
                  <Border Background="{StaticResource YellowBrush}" Margin="16,0,16,10" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="TOTAL" FontFamily="Consolas,Courier New,monospace"
                                 FontWeight="Black" Foreground="{StaticResource InkBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewTotalDisplay}" FontFamily="Consolas,Courier New,monospace"
                                 FontWeight="Black" Foreground="{StaticResource InkBrush}"/>
                    </Grid>
                  </Border>

                  <!-- Cash: tendered + change -->
                  <StackPanel Margin="20,0,20,10" Spacing="4" IsVisible="{Binding IsPreviewCashPayment}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="CASH" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewAmountTenderedDisplay}" FontFamily="Consolas,Courier New,monospace" FontSize="11.5"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="CHANGE" FontFamily="Consolas,Courier New,monospace" FontSize="11.5" FontWeight="Bold"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewChangeDueDisplay}" FontFamily="Consolas,Courier New,monospace" FontSize="11.5" FontWeight="Bold"/>
                    </Grid>
                  </StackPanel>

                  <!-- Non-cash: payment method + reference -->
                  <StackPanel Margin="20,0,20,10" Spacing="4" IsVisible="{Binding IsPreviewNonCashPayment}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding PreviewPaymentMethod, StringFormat='PAID VIA {0}'}"
                                 FontFamily="Consolas,Courier New,monospace" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="REF" FontFamily="Consolas,Courier New,monospace" FontSize="10.5" Foreground="{StaticResource GrayBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding PreviewReferenceNumber}" FontFamily="Consolas,Courier New,monospace" FontSize="10.5" Foreground="{StaticResource GrayBrush}"/>
                    </Grid>
                  </StackPanel>

                  <!-- Footer text (only if set) -->
                  <TextBlock Text="------------------------------------"
                             FontFamily="Consolas,Courier New,monospace" FontSize="10"
                             Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"
                             IsVisible="{Binding ReceiptFooterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <TextBlock Text="{Binding ReceiptFooterText}" FontFamily="Consolas,Courier New,monospace"
                             FontSize="10.5" FontStyle="Italic" HorizontalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}"
                             Margin="20,0,20,22"
                             IsVisible="{Binding ReceiptFooterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                </StackPanel>
              </Border>

              <Button Classes="accent-blue" MaxWidth="300" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Padding="0,12" Command="{Binding TestPrintCommand}" IsEnabled="{Binding !IsPrinting}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="PrinterOutline" Width="18" Height="18"/>
                  <TextBlock Text="{Binding IsPrinting, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue='TEST PRINT'}"/>
                  <TextBlock Text="TEST PRINT" IsVisible="{Binding !IsPrinting}"/>
                  <TextBlock Text="PRINTING..." IsVisible="{Binding IsPrinting}"/>
                </StackPanel>
              </Button>

              <TextBlock Text="{Binding PrintStatusMessage}"
                         Foreground="{StaticResource BlueBrush}"
                         FontWeight="Bold"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         MaxWidth="300"
                         TextAlignment="Center"/>

            </StackPanel>
            </ScrollViewer>
            
        </Grid>
    </Grid>
</UserControl>