<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="640"
             x:Class="Cashere.Views.Admin.Settings.BusinessInfoView"
             x:DataType="vm:BusinessInfoViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="10" >
      <TextBlock Text="BUSINESS INFO" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

      
      <Grid ColumnDefinitions="Auto,*">
          <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="LOGO" Classes="eyebrow"/>
        <Border Grid.Column="0" Width="200" Height="200" CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource GrayLightBrush}" ClipToBounds="True" Margin="0,0,12,0">
          <Grid>              
            <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="6"
                   IsVisible="{Binding LogoPreview, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <mi:MaterialIcon Kind="ImageOutline" Width="22" Height="22" Foreground="{StaticResource GrayBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding LogoPreview, Converter={x:Static ObjectConverters.IsNull}}"/>
          </Grid>
        </Border>
              </StackPanel> 
        <StackPanel Grid.Column="1" Spacing="6" >

            <TextBlock Text="SHOP NAME" Classes="eyebrow"/>
      <TextBox Text="{Binding ShopName}"/>

      <TextBlock Text="ADDRESS" Classes="eyebrow"/>
      <TextBox Text="{Binding Address}"/>


          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="chip" Command="{Binding PickLogoCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Upload" Width="14" Height="14"/>
                <TextBlock Text="CHOOSE LOGO"/>
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding RemoveLogoCommand}"
                    IsVisible="{Binding LogoPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16"/>
            </Button>
          </StackPanel>
          <TextBlock Text="Shown on this screen and the on-screen receipt preview. PNG, JPG or WEBP."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
          <TextBlock Text="PHONE" Classes="eyebrow"/>
          <TextBox Text="{Binding Phone}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
          <TextBlock Text="EMAIL" Classes="eyebrow"/>
          <TextBox Text="{Binding Email}"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="TAX ID / BUSINESS REGISTRATION NUMBER" Classes="eyebrow"/>
      <TextBox Text="{Binding TaxId}"/>

      <TextBlock Text="CURRENCY CODE" Classes="eyebrow"/>
      <TextBox Text="{Binding Currency}"/>

      <TextBlock Text="TIMEZONE" Classes="eyebrow"/>
      <ComboBox ItemsSource="{Binding TimezoneOptions}" SelectedItem="{Binding Timezone}" HorizontalAlignment="Stretch"/>
      <TextBlock Text="Used to evaluate business hours. Displayed timestamps still follow this device's own local clock."
                 Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>

      <Border Classes="rule-thick" Margin="0,4"/>
      <TextBlock Text="BUSINESS HOURS" Classes="eyebrow"/>
      <ItemsControl ItemsSource="{Binding BusinessHours}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BusinessDayFormItem">
            <Grid ColumnDefinitions="90,Auto,90,20,90" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{Binding DayLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
              <CheckBox Grid.Column="1" Content="CLOSED" IsChecked="{Binding IsClosed}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="2" Text="{Binding OpenTime}" Watermark="09:00" Classes="compact" IsEnabled="{Binding !IsClosed}"/>
              <TextBlock Grid.Column="3" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBox Grid.Column="4" Text="{Binding CloseTime}" Watermark="17:00" Classes="compact" IsEnabled="{Binding !IsClosed}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="ENFORCE BUSINESS HOURS AT CHECKOUT" FontWeight="Bold"/>
          <TextBlock Text="Block new sales outside the configured weekly schedule. Uses the shop timezone above."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceBusinessHoursAtCheckout}" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="Times use 24-hour format. When enforcement is enabled, new checkouts are blocked outside these hours."
                 Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>

      <TextBlock Text="{Binding StatusMessage}"
           Foreground="{StaticResource BlueBrush}"
           FontWeight="Bold"
           TextWrapping="Wrap"
           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <Button Content="SAVE"
              Classes="accent-blue"
              Command="{Binding SaveCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="0,14"
              Margin="0,8,0,4"/>

      <Border Classes="rule-thick" Margin="0,8"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="ClockOutline" Width="14" Height="14" Foreground="{StaticResource GrayBrush}"/>
        <TextBlock Text="RECEIPT LOGO" Classes="eyebrow"/>
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"
                 Text="The configured Windows printer now receives the saved logo as a centered image above the receipt text. Print a test receipt to confirm sizing and grayscale quality on your printer."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
