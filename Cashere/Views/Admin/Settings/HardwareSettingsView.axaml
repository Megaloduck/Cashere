<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="720"
             x:Class="Cashere.Views.Admin.Settings.HardwareSettingsView"
             x:DataType="vm:HardwareSettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="10"        >
      <TextBlock Text="HARDWARE" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

      <StackPanel Spacing="10" IsVisible="{Binding IsPrinterServiceAvailable}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="PrinterOutline" Width="16" Height="16" Foreground="{StaticResource BlueBrush}"/>
          <TextBlock Text="RECEIPT PRINTER" Classes="eyebrow"/>
        </StackPanel>

        <TextBlock Text="PRINTER" Classes="eyebrow" FontSize="9"/>
        <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinterName}" HorizontalAlignment="Stretch"/>

        <TextBlock Text="PAPER WIDTH" Classes="eyebrow" FontSize="9"/>
        <ComboBox ItemsSource="{Binding PaperWidths}" SelectedItem="{Binding PaperWidthMm}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StringFormat='{}{0}mm'}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Classes="accent-yellow" Command="{Binding TestPrintCommand}" IsEnabled="{Binding !IsTestPrinting}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,14">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="PrinterOutline" Width="16" Height="16"/>
            <TextBlock Text="TEST PRINT" IsVisible="{Binding !IsTestPrinting}"/>
            <TextBlock Text="PRINTING..." IsVisible="{Binding IsTestPrinting}"/>
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding TestPrintStatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource BlueBrush}"
                   IsVisible="{Binding TestPrintStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding !IsPrinterServiceAvailable}">
        <mi:MaterialIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="{StaticResource RedBrush}"/>
        <TextBlock Text="PRINTER SERVICE UNAVAILABLE IN THIS BUILD" Classes="eyebrow"/>
      </StackPanel>

      <Border Classes="rule-thick" Margin="0,8"/>
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="BARCODE SCANNER" Classes="headline" FontSize="14"/>
          <TextBlock Text="USB scanners that act as a keyboard can scan directly into the product search. Configure the scanner to send Enter after each barcode." TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Auto-add an exact barcode scan" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoAddScannedBarcode}"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="14" IsVisible="{Binding SupportsCashDrawerKick}">
        <StackPanel Spacing="8">
          <TextBlock Text="CASH DRAWER" Classes="headline" FontSize="14"/>
          <TextBlock Text="For a drawer connected to the receipt printer's drawer port and a printer that accepts raw ESC/POS commands. Disabled by default. A cash payment sends the standard pin 2 pulse to the selected receipt printer."
                     TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Kick drawer after cash payment" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCashDrawerKick}"/>
          </Grid>
          <Button Content="TEST CASH DRAWER (MAY OPEN IT)" Classes="accent-yellow" Command="{Binding TestCashDrawerCommand}"
                  IsEnabled="{Binding !IsTestingCashDrawer}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,12"/>
          <TextBlock Text="{Binding CashDrawerTestStatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource BlueBrush}"
                     IsVisible="{Binding CashDrawerTestStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="CUSTOMER-FACING DISPLAY" Classes="headline" FontSize="14"/>
          <TextBlock Text="When enabled, Cashere opens a full-screen cart display on a connected secondary monitor while the POS is open." TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Enable customer display" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCustomerDisplay}"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource BlueBrush}"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <Button Content="SAVE SETTINGS"
              Classes="accent-blue"
              Command="{Binding SaveCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="0,14"/>

      <TextBlock Text="OTHER DEVICE INTEGRATIONS" Classes="eyebrow"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"
                 Text="EDC terminal pairing depends on the provider's supported API or SDK. The Windows desktop printer can print the saved PNG/JPEG business logo; print a test receipt to check sizing and image quality."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
