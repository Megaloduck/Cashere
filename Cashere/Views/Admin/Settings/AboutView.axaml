<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="Cashere.Views.Admin.Settings.AboutView"
             x:DataType="vm:AboutViewModel">

      <!-- Header -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12" >
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="ABOUT" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshCommand}">
          <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
        </Button>
      </Grid>
      <Border Classes="rule-thick"/>

      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="12" Height="12" Background="{StaticResource RedBrush}"/>
          <Border Width="12" Height="12" Background="{StaticResource YellowBrush}"/>
          <Border Width="12" Height="12" Background="{StaticResource BlueBrush}"/>
        </StackPanel>
        <TextBlock Text="CASHERE" Classes="headline" FontSize="24" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding AppVersion, StringFormat='Point of Sale — {0}'}" Foreground="{StaticResource GrayBrush}"/>
      </StackPanel>

      <Border Classes="card" Padding="14" Margin="0,8,0,0">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Database" Width="16" Height="16" Foreground="{StaticResource BlueBrush}"/>
            <TextBlock Text="DATABASE STATUS" Classes="eyebrow"/>
          </StackPanel>
          <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource GrayBrush}"/>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Grid.Column="0">
              <TextBlock Text="SIZE" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding DatabaseSizeDisplay}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="LAST MODIFIED" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding LastModifiedDisplay}" FontWeight="Bold" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="MIGRATIONS" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding AppliedMigrationCount}" FontWeight="Bold"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="rule-thick" Margin="0,4"/>
      <TextBlock Text="THIRD-PARTY SOFTWARE" Classes="eyebrow"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"
                 Text="Packages used by the desktop build and their declared license identifiers. Use the links to review the full license terms; the index is generated from the restored NuGet dependency graph."/>
      <ItemsControl ItemsSource="{Binding ThirdPartyLicenses}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ThirdPartyLicenseInfo">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,1" Padding="0,9">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Package}" FontWeight="Bold" FontSize="12"/>
                  <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Foreground="{StaticResource GrayBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding License}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding LicenseUrl}" Foreground="{StaticResource BlueBrush}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="280" ToolTip.Tip="{Binding LicenseUrl}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
