<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="Cashere.Views.Admin.Settings.DataBackupSettingsView"
             x:DataType="vm:DataBackupSettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12" >
      <TextBlock Text="DATA &amp; BACKUP" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

      <Border Classes="card" Padding="14">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Database" Width="16" Height="16" Foreground="{StaticResource BlueBrush}"/>
            <TextBlock Text="DATABASE STATUS" Classes="eyebrow"/>
          </StackPanel>
          <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource GrayBrush}"/>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0">
              <TextBlock Text="SIZE" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding DatabaseSizeDisplay}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="LAST MODIFIED" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding LastModifiedDisplay}" FontWeight="Bold"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Button Content="CREATE BACKUP NOW"
              Classes="accent-blue"
              Command="{Binding CreateBackupCommand}"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="0,14"/>

      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" TextWrapping="Wrap"/>

      <Border Classes="rule-thick" Margin="0,4"/>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="BACKUPS" Classes="eyebrow" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshCommand}">
          <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
        </Button>
      </Grid>

      <ItemsControl ItemsSource="{Binding Backups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:BackupFileInfo">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,10">
              <Grid ColumnDefinitions="*,80,140,Auto">
                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="{Binding CreatedUtc, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Click="OnRestoreClick" ToolTip.Tip="Restore this backup">
                    <mi:MaterialIcon Kind="BackupRestore" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnDeleteBackupClick" ToolTip.Tip="Delete this backup">
                    <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="No backups yet - create one above." Foreground="{StaticResource GrayBrush}" FontSize="12"
                 IsVisible="{Binding HasNoBackups}"/>

      <Border Classes="rule-thick" Margin="0,8"/>
      <TextBlock Text="COMING SOON" Classes="eyebrow"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"
                 Text="Automatic scheduled backups with retention, and CSV/Excel export/import of catalog and sales data, aren't built yet."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>