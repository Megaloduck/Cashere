<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="Cashere.Views.Admin.Settings.PreferencesView"
             x:DataType="vm:PreferencesViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12" >
      <TextBlock Text="PREFERENCES" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

      <TextBlock Text="THEME" Classes="eyebrow"/>
      <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch"/>
      <TextBlock Text="System follows your OS's light/dark setting, including if you change it while Cashere is running."
                 Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>

      <TextBlock Text="CONTROL DENSITY" Classes="eyebrow" Margin="0,8,0,0"/>
      <ComboBox ItemsSource="{Binding UiDensities}" SelectedItem="{Binding SelectedUiDensity}" HorizontalAlignment="Stretch"/>
      <TextBlock Text="Compact reduces padding and height on common inputs, buttons, pickers and date controls. Comfortable keeps the default touch-friendly size."
                 Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>

      <TextBlock Text="NUMBER AND DATE FORMAT" Classes="eyebrow" Margin="0,8,0,0"/>
      <ComboBox ItemsSource="{Binding DisplayCultures}" SelectedItem="{Binding SelectedDisplayCulture}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DisplayCultureOption">
            <TextBlock Text="{Binding DisplayName}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="This changes number separators and date/month formatting. The app interface remains in English; the selected format takes effect after restarting Cashere."
                 Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="SHOW CLOCK IN HEADER" FontWeight="Bold"/>
          <TextBlock Text="Shows the current day, date, month, year and time in the POS/Admin header bar."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHeaderClock}" VerticalAlignment="Center"/>
      </Grid>

      <StackPanel Spacing="8" IsVisible="{Binding ShowHeaderClock}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="DAY" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHeaderDay}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="DATE" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHeaderDate}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="MONTH" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHeaderMonth}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="YEAR" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHeaderYear}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="HOURS" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHeaderHours}"/>
        </Grid>
      </StackPanel>

      <TextBlock Text="POS FEEDBACK" Classes="eyebrow" Margin="0,8,0,0"/>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="SOUND ON CHECKOUT RESULT" FontWeight="Bold"/>
          <TextBlock Text="Plays a Windows system sound when a sale completes or checkout fails."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PosSoundsEnabled}" VerticalAlignment="Center"/>
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="SHOW POS SUCCESS NOTICES" FontWeight="Bold"/>
          <TextBlock Text="Shows confirmations when an order is held, resumed, or completed. Checkout errors stay visible."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPosNotifications}" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource BlueBrush}"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <Button Content="SAVE"
              Classes="accent-blue"
              Command="{Binding SaveCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="0,14"
              Margin="0,8,0,4"/>

     <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="ClockOutline" Width="14" Height="14" Foreground="{StaticResource BlueBrush}"/>
        <TextBlock Text="All timestamps (header clock, shifts, sales, receipts) always display in this device's own local time zone."
                   TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>

      <Border Classes="rule-thick" Margin="0,8"/>
      <TextBlock Text="LOCALIZATION ROADMAP" Classes="eyebrow"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"
                 Text="Translated interface labels and notification support on platforms other than Windows desktop still need localization and platform work."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
