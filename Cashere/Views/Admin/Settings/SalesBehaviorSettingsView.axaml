<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="620"
             x:Class="Cashere.Views.Admin.Settings.SalesBehaviorSettingsView"
             x:DataType="vm:SalesBehaviorSettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12" >
      <TextBlock Text="SALES BEHAVIOR" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="REQUIRE CUSTOMER BEFORE CHECKOUT" FontWeight="Bold"/>
          <TextBlock Text="Cashier must pick a customer in Checkout before Complete Sale is enabled."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RequireCustomerBeforeCheckout}" VerticalAlignment="Center"/>
      </Grid>


      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="AUTO-PRINT RECEIPT AFTER PAYMENT" FontWeight="Bold"/>
          <TextBlock Text="Sends a receipt to whatever printer is configured under Settings -> Hardware automatically when a sale completes."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPrintReceiptAfterPayment}" VerticalAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="ENABLE HELD ORDERS" FontWeight="Bold"/>
          <TextBlock Text="Allow cashiers to save an unfinished order and resume it later. Held orders are stored on this register."
                     Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHeldOrders}" VerticalAlignment="Center"/>
      </Grid>

      <Border Classes="rule-thick" Margin="0,4"/>
      <TextBlock Text="SALE NUMBER FORMAT" Classes="eyebrow"/>
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
          <TextBlock Text="PREFIX" Classes="eyebrow"/>
          <TextBox Text="{Binding SaleNumberPrefix}" Watermark="S"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom" Margin="6,0">
          <TextBlock Text="DATE" Classes="eyebrow"/>
          <ToggleSwitch IsChecked="{Binding IncludeDateInSaleNumber}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,0,0">
          <TextBlock Text="SEQUENCE DIGITS" Classes="eyebrow"/>
          <TextBox Text="{Binding SaleNumberSequenceDigits}" Watermark="4"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="With date on, the format is PREFIX + YYYYMMDD + sequence. With date off, the sequence continues across all sales."
                 Foreground="{StaticResource GrayBrush}" FontSize="11" TextWrapping="Wrap"/>

<TextBlock Text="{Binding StatusMessage}"
           Foreground="{StaticResource BlueBrush}"
           FontWeight="Bold"
           TextWrapping="Wrap"
           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <Button Content="SAVE"
              Classes="accent-blue"
              Command="{Binding SaveCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="0,14"
              Margin="0,8,0,4"/>

      <Border Classes="rule-thick" Margin="0,8"/>
      <TextBlock Text="ORDER TYPES" Classes="eyebrow"/>
      <TextBlock Text="Set the labels this shop uses. Separate them with commas; cashiers choose one for each order. Keep only “Sale” for a simple retail checkout." TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11"/>
      <TextBox Text="{Binding OrderTypes}" Watermark="Sale, Dine-in, Takeaway, Delivery"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
