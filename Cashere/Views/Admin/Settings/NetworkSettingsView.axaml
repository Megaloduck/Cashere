<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Cashere.Views.Admin.Settings.NetworkSettingsView"
             x:DataType="vm:NetworkSettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">

      <TextBlock Text="SYNCHRONIZATION" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

        <!-- Pairing configurations + QR, side by side -->
        <Grid ColumnDefinitions="*,Auto" >

    <!-- Pairing Configurations -->
    <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,16,0">
        <TextBlock Text="BIND ADDRESS" Classes="eyebrow"/>
        <ComboBox ItemsSource="{Binding AvailableBindAddresses}"
                  SelectedItem="{Binding ServerBindAddress}"
                  HorizontalAlignment="Stretch"/>
        <TextBlock Text="0.0.0.0 binds every network adapter on this PC - the safe default. Pick a specific address only to restrict which network the till is reachable on."
                   Foreground="{StaticResource GrayBrush}"
                   TextWrapping="Wrap"
                   FontSize="11"/>

        <TextBlock Text="PORT" Classes="eyebrow"/>
        <TextBox Text="{Binding ServerPort}" Watermark="5177"/>

        <TextBlock Text="Changes take effect the next time Cashere is started."
                   Foreground="{StaticResource GrayBrush}"
                   TextWrapping="Wrap"
                   FontSize="11"/>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{StaticResource BlueBrush}"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- QR Image Pairing -->
    <StackPanel Grid.Column="1"
                Spacing="8"
                IsVisible="{Binding IsPairingQrCodeAvailable}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,8">
        <TextBlock Text="SCAN TO PAIR A PHONE" Classes="eyebrow" HorizontalAlignment="Center"/>
        <Border Classes="card" Padding="12" Width="180" Height="180">
            <Image Source="{Binding PairingQrCodeImage}" Stretch="Uniform"/>
        </Border>
    </StackPanel>
</Grid>


      <Button Content="SAVE SETTINGS"
              Classes="accent-blue"
              Command="{Binding SaveCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="0,14"
              Margin="0,8,0,0"/>


      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="CONNECTED DEVICES" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="accent-yellow" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
            <TextBlock Text="REFRESH"/>
          </StackPanel>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="2*,1*,1.3*,90" Margin="0,0,0,4" IsVisible="{Binding IsServiceAvailable}">
        <TextBlock Grid.Column="0" Text="DEVICE" Classes="eyebrow"/>
        <TextBlock Grid.Column="1" Text="IP ADDRESS" Classes="eyebrow"/>
        <TextBlock Grid.Column="2" Text="CONNECTED SINCE" Classes="eyebrow"/>
        <TextBlock Grid.Column="3" Text="ACTIONS" Classes="eyebrow" HorizontalAlignment="Center"/>
      </Grid>
      <Border Classes="rule-thick" IsVisible="{Binding IsServiceAvailable}"/>

      <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding IsServiceAvailable}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:ConnectedDeviceInfo">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,10">
              <Grid ColumnDefinitions="2*,1*,1.3*,90">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CellphoneLink" Width="18" Height="18" Foreground="{StaticResource BlueBrush}"/>
                  <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding IpAddress}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ConnectedAt, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Classes="ghost" Click="OnKickClick" ToolTip.Tip="Disconnect this device">
                    <mi:MaterialIcon Kind="CellphoneRemove" Width="18" Height="18"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Center"
                  IsVisible="{Binding HasNoDevices}">
        <mi:MaterialIcon Kind="CellphoneOff" Width="32" Height="32" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="NO DEVICES CONNECTED" Classes="eyebrow" HorizontalAlignment="Center"/>
        <TextBlock Text="Pair a phone from the Cashere mobile app to see it here." Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>

      <StackPanel Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Center"
                  IsVisible="{Binding !IsServiceAvailable}">
        <mi:MaterialIcon Kind="AlertCircleOutline" Width="32" Height="32" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="DEVICE TRACKING UNAVAILABLE" Classes="eyebrow" HorizontalAlignment="Center"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>