<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin.Settings"
             xmlns:models="clr-namespace:Cashere.Models"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="760"
             x:Class="Cashere.Views.Admin.Settings.StaffPermissionsView"
             x:DataType="vm:StaffPermissionsViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">
      <TextBlock Text="STAFF &amp; PERMISSIONS" Classes="headline" FontSize="18"/>
      <Border Classes="rule-thick"/>

      <TextBlock Text="ROLE ACCESS" Classes="eyebrow"/>

      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Background="{StaticResource BlueBrush}" CornerRadius="{StaticResource RadiusPill}" Padding="10,3" VerticalAlignment="Top">
              <TextBlock Text="OWNER" FontWeight="Black" FontSize="10" Foreground="White"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Full access, including cashier account management, security settings, and reset."
                       TextWrapping="Wrap" Margin="10,0,0,0"/>
          </Grid>
          <Border Classes="rule-thick"/>
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Background="{StaticResource YellowBrush}" CornerRadius="{StaticResource RadiusPill}" Padding="10,3" VerticalAlignment="Top">
              <TextBlock Text="CASHIER" FontWeight="Black" FontSize="10" Foreground="Black"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Operational admin access for products, purchases, suppliers, customers, vouchers, sales history and reports, plus non-security settings. Cannot manage cashier accounts or security settings."
                       TextWrapping="Wrap" Margin="10,0,0,0"/>
          </Grid>
          <Border Classes="rule-thick"/>
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Background="{StaticResource YellowBrush}" CornerRadius="{StaticResource RadiusPill}" Padding="10,3" VerticalAlignment="Top">
              <TextBlock Text="CASHIER" FontWeight="Black" FontSize="10" Foreground="Black"/>
            </Border>
            <TextBlock Grid.Column="1" Text="POS access and read-only product lookup. Admin management sections are hidden and blocked."
                       TextWrapping="Wrap" Margin="10,0,0,0"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="14">
        <StackPanel Spacing="9">
          <TextBlock Text="CASHIER POS PERMISSIONS" Classes="headline" FontSize="14"/>
          <TextBlock Text="Refund and void requests always require an Owner or Manager PIN. Cashiers only see their own sales when sales history is enabled." TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="11"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="View own sales history" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CashierCanViewOwnSalesHistory}"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Request refunds (manager PIN required)" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CashierCanRequestRefunds}"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Request voids (manager PIN required)" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CashierCanRequestVoids}"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Apply active vouchers at checkout" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CashierCanApplyVouchers}"/>
          </Grid>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Button Content="SAVE CASHIER PERMISSIONS" Classes="accent-blue" Command="{Binding SavePermissionsCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0"  Spacing="8">
              <TextBlock Text="CASHIERS ON FILE" Classes="eyebrow" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="LockCheckOutline" Width="16" Height="16" Foreground="{StaticResource BlueBrush}"/>
        <TextBlock Text="Cashiers sign in with a username and PIN, verified against the PBKDF2 hash on their account."
                   TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
          </StackPanel>
        
        <Button Grid.Column="1" Classes="chip" Command="{Binding ManageCashiersCommand}" IsVisible="{Binding CanManageCashierAccounts}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="AccountTieOutline" Width="14" Height="14"/>
            <TextBlock Text="MANAGE CASHIERS"/>
          </StackPanel>
        </Button>
      </Grid>
      <Border Classes="rule-thick" VerticalAlignment="Bottom"/>

      <ItemsControl ItemsSource="{Binding Cashiers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Cashier">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,8">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Role}" Margin="8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="ACTIVE" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" IsVisible="{Binding IsActive}"/>
                <TextBlock Grid.Column="2" Text="INACTIVE" Foreground="{StaticResource RedBrush}" FontWeight="Bold" IsVisible="{Binding !IsActive}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="rule-thick" Margin="0,8"/>
      <TextBlock Text="PER ACTION PERMISSIONS" Classes="eyebrow"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GrayBrush}" FontSize="12"
                 Text="Voucher discounts, refunds and void requests have role controls above. Manual discount entry, per-item price overrides and cash-drawer access depend on those workflows and device support being added."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
