<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             xmlns:models="clr-namespace:Cashere.Models"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Cashere.Views.Admin.SupplierAdminView"
             x:DataType="vm:SupplierAdminViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="SUPPLIERS" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Classes="accent-blue" Command="{Binding AddNewCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
          <TextBlock Text="NEW SUPPLIER"/>
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Suppliers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Supplier">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,10">
              <Grid ColumnDefinitions="2*,1*,2*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Phone}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ContactPerson}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Click="OnEditClick" ToolTip.Tip="Edit">
                    <mi:MaterialIcon Kind="PencilOutline" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="ghost" Click="OnDeleteClick" ToolTip.Tip="Delete">
                    <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.RowSpan="2" Background="#CC141414" IsVisible="{Binding IsEditorOpen}">
      <Border Classes="card" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding EditorTitle}" Classes="headline" FontSize="18"/>
          <Border Classes="rule-thick"/>

          <TextBlock Text="NAME" Classes="eyebrow"/>
          <TextBox Text="{Binding FormName}"/>

          <TextBlock Text="CONTACT PERSON" Classes="eyebrow"/>
          <TextBox Text="{Binding FormContactPerson}"/>

          <TextBlock Text="PHONE" Classes="eyebrow"/>
          <TextBox Text="{Binding FormPhone}"/>

          <TextBlock Text="ADDRESS" Classes="eyebrow"/>
          <TextBox Text="{Binding FormAddress}"/>

          <TextBlock Text="NOTES" Classes="eyebrow"/>
          <TextBox Text="{Binding FormNotes}" AcceptsReturn="True" Height="60"/>

          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="CANCEL" Classes="ghost" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="SAVE" Classes="accent-blue" Command="{Binding SaveCommand}" Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>