<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Admin"
             xmlns:services="clr-namespace:Cashere.Services"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Cashere.Views.Admin.DevicesAdminView"
             x:DataType="vm:DevicesAdminViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="CONNECTED DEVICES" Classes="headline" FontSize="18" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Classes="accent-blue" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
          <TextBlock Text="REFRESH"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="2*,1*,1.3*" Margin="0,0,0,4" IsVisible="{Binding IsServiceAvailable}">
      <TextBlock Grid.Column="0" Text="DEVICE" Classes="eyebrow"/>
      <TextBlock Grid.Column="1" Text="IP ADDRESS" Classes="eyebrow"/>
      <TextBlock Grid.Column="2" Text="CONNECTED SINCE" Classes="eyebrow"/>
    </Grid>
    <Border Grid.Row="1" Classes="rule-thick" VerticalAlignment="Bottom" IsVisible="{Binding IsServiceAvailable}"/>

    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsServiceAvailable}">
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:ConnectedDeviceInfo">
            <Border BorderBrush="{StaticResource GrayLightBrush}" BorderThickness="0,0,0,2" Padding="0,10">
              <Grid ColumnDefinitions="2*,1*,1.3*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CellphoneLink" Width="18" Height="18" Foreground="{StaticResource BlueBrush}"/>
                  <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding IpAddress}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ConnectedAt, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding HasNoDevices}">
      <mi:MaterialIcon Kind="CellphoneOff" Width="32" Height="32" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="NO DEVICES CONNECTED" Classes="eyebrow" HorizontalAlignment="Center"/>
      <TextBlock Text="Pair a phone from the Cashere mobile app to see it here." Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding !IsServiceAvailable}">
      <mi:MaterialIcon Kind="AlertCircleOutline" Width="32" Height="32" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="DEVICE TRACKING UNAVAILABLE" Classes="eyebrow" HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>