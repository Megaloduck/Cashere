    <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Pos"
             xmlns:views="clr-namespace:Cashere.Views.Pos"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Cashere.Views.Pos.PosView"
             x:DataType="vm:PosViewModel">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" Padding="20,14">
  <Grid ColumnDefinitions="Auto,*,Auto">
    <!-- Left: Brand -->
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Border Width="14" Height="14" Background="{StaticResource RedBrush}"/>
      <Border Width="14" Height="14" Background="{StaticResource YellowBrush}"/>
      <Border Width="14" Height="14" Background="{StaticResource BlueBrush}"/>
      <StackPanel Margin="10,0,0,0">
        <TextBlock Text="CASHERE" Classes="headline" Foreground="White"/>
        <TextBlock Text="POINT OF SALE" Classes="eyebrow" Foreground="#B8B8B8"/>
      </StackPanel>
    </StackPanel>

    <!-- Center: Header Clock -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                IsVisible="{Binding HeaderClock.IsVisible}">
      <TextBlock Text="{Binding HeaderClock.DayText}" IsVisible="{Binding HeaderClock.ShowDay}"
                 Foreground="#B8B8B8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding HeaderClock.DateText}" IsVisible="{Binding HeaderClock.ShowDate}"
                 Foreground="White" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding HeaderClock.MonthText}" IsVisible="{Binding HeaderClock.ShowMonth}"
                 Foreground="White" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding HeaderClock.YearText}" IsVisible="{Binding HeaderClock.ShowYear}"
                 Foreground="#B8B8B8" FontSize="13" VerticalAlignment="Center"/>
      <Border Background="{StaticResource YellowBrush}" CornerRadius="{StaticResource RadiusPill}" Padding="10,3"
              IsVisible="{Binding HeaderClock.ShowHours}">
        <TextBlock Text="{Binding HeaderClock.HoursText}" Foreground="Black" FontWeight="Black" FontSize="14"/>
      </Border>
    </StackPanel>   

    <!-- Right: Admin button + Cashier badge -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                VerticalAlignment="Center" HorizontalAlignment="Right">
      <Button Content="ADMIN" Classes="accent-blue" Command="{Binding OpenAdminCommand}"/>
      <Border Background="{StaticResource YellowBrush}" Padding="12,-10" CornerRadius="5">
        <TextBlock Text="{Binding CurrentCashierName, StringFormat='CASHIER: {0}'}" FontWeight="Bold"
                   Foreground="Black" VerticalAlignment="Center"/>
      </Border>
    </StackPanel>
  </Grid>
</Border>

      <!-- Bauhaus tri-color signature strip -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Height="6">
        <Border Grid.Column="0" Background="{StaticResource RedBrush}"/>
        <Border Grid.Column="1" Background="{StaticResource YellowBrush}"/>
        <Border Grid.Column="2" Background="{StaticResource BlueBrush}"/>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="2*,1*">
        <views:ProductPickerView Grid.Column="0" DataContext="{Binding ProductPicker}" Margin="16"/>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="0,16,16,16">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8" IsVisible="{Binding HasMultipleOrderTypes}">
            <TextBlock Text="ORDER TYPE" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding OrderTypes}" SelectedItem="{Binding SelectedOrderType}" HorizontalAlignment="Stretch"/>
          </Grid>
          <views:CartView Grid.Row="1" DataContext="{Binding Cart}"/>
          <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
            <TextBlock Text="{Binding LastReceiptSummary}" TextWrapping="Wrap" Foreground="{StaticResource BlueBrush}" FontWeight="Bold"
                       IsVisible="{Binding LastReceiptSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Content="HOLD ORDER" Classes="accent-yellow" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                      IsVisible="{Binding IsHeldOrdersEnabled}"
                      Command="{Binding HoldOrderCommand}" IsEnabled="{Binding Cart.HasItems}" IsVisible=""/>
              <Button Grid.Column="1" Content="CHECKOUT" Classes="accent-blue" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                      Padding="0,16" FontSize="18" FontWeight="Bold"
                      Command="{Binding OpenCheckoutCommand}" IsEnabled="{Binding Cart.HasItems}"/>
            </Grid>
          </StackPanel>
          <Border Grid.Row="3" Classes="card" Padding="10" Margin="0,8,0,0"
                  IsVisible="{Binding ShowHeldOrders}" MaxHeight="150">
            <StackPanel Spacing="6">
              <TextBlock Text="HELD ORDERS" Classes="eyebrow"/>
              <ScrollViewer MaxHeight="112">
                <ItemsControl ItemsSource="{Binding HeldOrders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeldOrder">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11"/>
                          <TextBlock Text="{Binding OrderType, StringFormat='TYPE: {0}'}" FontSize="9" Foreground="{StaticResource GrayBrush}"/>
                          <TextBlock Text="{Binding TotalAmount, StringFormat='Rp {0:N0}'}" FontSize="10" Foreground="{StaticResource GrayBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="RESUME" Classes="accent-blue" Padding="8,4" Margin="0,0,3,0"
                                Command="{Binding $parent[UserControl].((vm:PosViewModel)DataContext).ResumeHeldOrderCommand}"
                                CommandParameter="{Binding}"/>
                        <Button Grid.Column="2" Content="×" Classes="ghost" Padding="8,4"
                                Command="{Binding $parent[UserControl].((vm:PosViewModel)DataContext).DiscardHeldOrderCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Discard held order"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Background="#CC141414" IsVisible="{Binding IsCheckoutOpen}" CornerRadius="15">
      <Border Classes="card" Width="420" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CheckoutView DataContext="{Binding Checkout}"/>
      </Border>
    </Border>
  </Grid>
</UserControl>
