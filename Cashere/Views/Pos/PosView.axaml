<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Pos"
             xmlns:views="clr-namespace:Cashere.Views.Pos"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Cashere.Views.Pos.PosView"
             x:DataType="vm:PosViewModel">
  <Grid>
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#1F2937" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Cashere POS" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding CurrentCashierName, StringFormat='Cashier: {0}'}" Foreground="White" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="2*,1*">
        <views:ProductPickerView Grid.Column="0" DataContext="{Binding ProductPicker}" Margin="12"/>

        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="0,12,12,12">
          <views:CartView Grid.Row="0" DataContext="{Binding Cart}"/>
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding LastReceiptSummary}" TextWrapping="Wrap" Foreground="Green"/>
            <Button Content="Checkout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,14" FontSize="18" FontWeight="Bold"
                    Command="{Binding OpenCheckoutCommand}" IsEnabled="{Binding Cart.HasItems}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <Border Background="#88000000" IsVisible="{Binding IsCheckoutOpen}">
      <Border Width="420" Background="White" CornerRadius="8" Padding="20"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CheckoutView DataContext="{Binding Checkout}"/>
      </Border>
    </Border>
  </Grid>
</UserControl>
