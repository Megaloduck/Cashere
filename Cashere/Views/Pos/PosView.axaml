<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cashere.ViewModels.Pos"
             xmlns:views="clr-namespace:Cashere.Views.Pos"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Cashere.Views.Pos.PosView"
             x:DataType="vm:PosViewModel">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Background="{StaticResource InkBrush}" Padding="20,14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="14" Height="14" Background="{StaticResource RedBrush}"/>
            <Border Width="14" Height="14" Background="{StaticResource YellowBrush}"/>
            <Border Width="14" Height="14" Background="{StaticResource BlueBrush}"/>
            <StackPanel Margin="10,0,0,0">
              <TextBlock Text="CASHERE" Classes="headline" Foreground="White"/>
              <TextBlock Text="POINT OF SALE" Classes="eyebrow" Foreground="#B8B8B8"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Content="ADMIN" Classes="ghost" Foreground="White" Command="{Binding OpenAdminCommand}"/>
            <Border Background="{StaticResource YellowBrush}" Padding="12,6">
              <TextBlock Text="{Binding CurrentCashierName, StringFormat='CASHIER: {0}'}" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bauhaus tri-color signature strip -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Height="6">
        <Border Grid.Column="0" Background="{StaticResource RedBrush}"/>
        <Border Grid.Column="1" Background="{StaticResource YellowBrush}"/>
        <Border Grid.Column="2" Background="{StaticResource BlueBrush}"/>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="2*,1*">
        <views:ProductPickerView Grid.Column="0" DataContext="{Binding ProductPicker}" Margin="16"/>

        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="0,16,16,16">
          <views:CartView Grid.Row="0" DataContext="{Binding Cart}"/>
          <StackPanel Grid.Row="1" Spacing="10" Margin="0,14,0,0">
            <TextBlock Text="{Binding LastReceiptSummary}" TextWrapping="Wrap" Foreground="{StaticResource BlueBrush}" FontWeight="Bold"/>
            <Button Content="CHECKOUT" Classes="accent-blue" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,16" FontSize="18" FontWeight="Bold"
                    Command="{Binding OpenCheckoutCommand}" IsEnabled="{Binding Cart.HasItems}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <Border Background="#CC141414" IsVisible="{Binding IsCheckoutOpen}">
      <Border Classes="card" Width="420" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CheckoutView DataContext="{Binding Checkout}"/>
      </Border>
    </Border>
  </Grid>
</UserControl>