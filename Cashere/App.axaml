<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cashere"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cashere.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <Thickness x:Key="TextInputPadding">10,8</Thickness>
        <x:Double x:Key="TextInputFontSize">13</x:Double>
        <Thickness x:Key="ButtonControlPadding">16,10</Thickness>
        <Thickness x:Key="ChoiceControlPadding">10,8</Thickness>
        <Thickness x:Key="ChoiceItemPadding">10,8</Thickness>
        <x:Double x:Key="DatePickerControlHeight">35</x:Double>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <!-- Loaded after FluentTheme so the Bauhaus setters take precedence. -->
        <StyleInclude Source="avares://Cashere/Styles/BauhausTheme.axaml"/>
    </Application.Styles>
</Application>
